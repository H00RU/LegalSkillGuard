  "exact_analysis_command": ".venv/bin/python -c 'import json,hashlib,statistics,collections,datetime; from pathlib import Path; root=Path.cwd(); source=root/\"runs/legal_openexempt_v6_frozen_source_isolated_IID128_20261031_run01/scored_records.json\"; scored=json.loads(source.read_text()); common={(v[\"source_key\"],v[\"family\"]) for v in scored[\"utility45\"]}; paths=set(); digests={}; out={}; totals=collections.Counter(); unknown=collections.Counter()\ndef describe(rows):\n result={\"tasks\":len(rows),\"invalid_format\":sum(v[\"invalid_format\"] for v in rows),\"transport_errors\":sum(v[\"transport_error\"] for v in rows),\"finish_reasons\":dict(collections.Counter(v[\"finish_reason\"] for v in rows))}\n for field in (\"input_tokens\",\"output_tokens\"):\n  vals=[v[field] for v in rows if isinstance(v[field],int) and not isinstance(v[field],bool)]\n  missing=len(rows)-len(vals); result[field]={\"records_with_usage\":len(vals),\"records_missing_usage\":missing,\"total\":sum(vals) if not missing else None,\"mean_per_task\":statistics.mean(vals) if vals and not missing else None}\n return result\nfor arm,records in scored.items():\n assert len(records)==256 and {(v[\"source_key\"],v[\"family\"]) for v in records}==common\n rows=[]\n for record in records:\n  raw_path=record[\"raw_call_path\"]; assert raw_path not in paths; paths.add(raw_path)\n  data=(root/raw_path).read_bytes(); digests[raw_path]=hashlib.sha256(data).hexdigest(); raw=json.loads(data); response=raw.get(\"response\") or {}\n  row={\"family\":record[\"family\"],\"input_tokens\":response.get(\"prompt_tokens\"),\"output_tokens\":response.get(\"completion_tokens\"),\"finish_reason\":response.get(\"finish_reason\"),\"invalid_format\":bool(record[\"score\"][\"invalid_format\"]),\"transport_error\":bool(raw.get(\"transport_error\"))}; rows.append(row)\n  for field in (\"input_tokens\",\"output_tokens\"):\n   if isinstance(row[field],int) and not isinstance(row[field],bool): totals[field]+=row[field]\n   else: unknown[field]+=1\n out[arm]={\"all_tasks\":describe(rows),\"by_task\":{f:describe([v for v in rows if v[\"family\"]==f]) for f in (\"EC\",\"EV\")},\"native_f1_percent\":{f:100*statistics.mean(v[\"score\"][\"f1\"] for v in records if v[\"family\"]==f) for f in (\"EC\",\"EV\")}}\nassert len(paths)==2560 and totals[\"input_tokens\"]==19242658 and totals[\"output_tokens\"]==6841407 and not any(unknown.values())\nresult={\"generated_at_UTC\":datetime.datetime.now(datetime.timezone.utc).isoformat(),\"classification\":\"descriptive_offline_cost_analysis_of_unchanged_completed_predictions\",\"source_scored_records\":str(source.relative_to(root)),\"source_scored_records_sha256\":hashlib.sha256(source.read_bytes()).hexdigest(),\"unique_raw_response_files\":len(paths),\"raw_response_digest_manifest_sha256\":hashlib.sha256(json.dumps(digests,sort_keys=True,separators=(\",\",\":\")).encode()).hexdigest(),\"all_task_pairs_equal\":True,\"sources_per_task_per_arm\":128,\"all_arms_input_tokens\":totals[\"input_tokens\"],\"all_arms_output_tokens\":totals[\"output_tokens\"],\"no_new_model_teacher_tokenizer_grader_calls\":True,\"teacher_calls_during_frozen_evaluation\":0,\"all_failures_retained\":True,\"wall_clock_or_GPU_hours_not_inferred_from_tokens\":True,\"construction_costs_are_separate\":True,\"skillcommit_current_run_not_complete_and_not_in_this_table\":True,\"arms\":out}; print(json.dumps(result,ensure_ascii=False,indent=2))'"
