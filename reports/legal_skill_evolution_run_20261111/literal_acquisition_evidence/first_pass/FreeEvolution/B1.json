      "id": "section_3306_c_5_family_employment_exclusion",
      "intent": "Determine whether §3306(c)(5)(A) applies to an identified employee-employer relationship using affirmative literal family-relation mentions.",
      "procedure": "def apply(inputs, premises):\n    employer = inputs[\"employer\"]\n    employee = inputs[\"employee\"]\n    relations = inputs[\"case_family_relations\"]\n    applies = False\n    for relation in relations:\n        if len(relation) == 3:\n            owner = relation[0]\n            word = relation[1]\n            relative = relation[2]\n            if owner == employee and relative == employer and word in premises[\"employee_has_employer_as_relative_words\"]:\n                applies = True\n            if owner == employer and relative == employee and word in premises[\"employer_has_employee_as_relative_words\"]:\n                applies = True\n    if applies:\n        answer = \"Entailment\"\n    else:\n        answer = \"Contradiction\"\n    return {\"answer\": answer}",
