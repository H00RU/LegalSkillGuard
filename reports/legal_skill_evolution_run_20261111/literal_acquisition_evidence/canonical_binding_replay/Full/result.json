      "new": {
        "id": "section_3306_c_5_a_family_employment",
        "intent": "Determine whether §3306(c)(5)(A) applies because an individual performs service in the employ of that individual's son, daughter, or spouse.",
        "procedure": "def apply(inputs, premises):\n    applies = False\n    for relation in inputs['case_family_relations']:\n        if len(relation) == 3:\n            owner = relation[0]\n            kinship = relation[1]\n            relative = relation[2]\n            if owner == inputs['employee'] and relative == inputs['employer'] and (kinship in premises['excluded_employer_relations_to_employee']):\n                applies = True\n            if owner == inputs['employer'] and relative == inputs['employee'] and (kinship == 'spouse') and ('spouse' in premises['excluded_employer_relations_to_employee']):\n                applies = True\n            if owner == inputs['employer'] and relative == inputs['employee'] and (kinship == 'father' or kinship == 'mother') and ('son' in premises['excluded_employer_relations_to_employee'] or 'daughter' in premises['excluded_employer_relations_to_employee']):\n                applies = True\n    answer = 'Entailment' if applies else 'Contradiction'\n    return {'answer': answer}\n",
        "inputs": {
          "employer": {
            "arguments": {},
            "field": "employer",
            "mode": "argument",
            "question": "Who is the person employing the individual in the employment relationship at issue?",
            "skill_id": null,
            "type": "string"
          },
          "employee": {
            "arguments": {},
            "field": "employee",
            "mode": "argument",
            "question": "Who is the individual performing the service in the employment relationship at issue?",
            "skill_id": null,
            "type": "string"
          },
          "case_family_relations": {
            "arguments": {},
            "field": "case_family_relations",
            "mode": "argument",
            "question": "What affirmative family-relation mentions are supplied as [owner, literal kinship word, relative] triples?",
            "skill_id": null,
            "type": "array"
          }
        },
        "outputs": {
          "answer": {
            "description": "Entailment if an affirmative family relation establishes that the employee performs service in the employ of the employee's son, daughter, or spouse; otherwise Contradiction.",
            "query_clauses": [
              "3306(c)(5)"
            ],
            "type": "string"
          }
        },
        "premises": {
