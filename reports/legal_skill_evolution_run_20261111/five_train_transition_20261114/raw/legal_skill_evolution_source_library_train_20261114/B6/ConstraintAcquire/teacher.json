\",{\"scalar_argument\":0},{\"scalar_argument\":1},{\"scalar_argument\":2},{\"scalar_argument\":3}]],\"support_arguments\":[],\"support_from_terms\":[4],\"support_from_queries\":[]},{\"predicate\":\"emit_permission_representative_v3\",\"term\":[\"permission\",[\"receiving_party\"],[\"disclose\",[\"confidential_information\"],[\"representatives_of\",[\"receiving_party\"]]],[\"acquired_disclosure_condition_v3\",{\"scalar_argument\":0},{\"scalar_argument\":1},{\"scalar_argument\":2},{\"scalar_argument\":3}]],\"support_arguments\":[],\"support_from_terms\":[4],\"support_from_queries\":[]},{\"predicate\":\"emit_bounded_prohibition_v3\",\"term\":[\"prohibition\",[\"acquired_actor_v3\",{\"scalar_argument\":0}],[\"disclose\",[\"confidential_information\"],[\"acquired_recipient_class_v3\",{\"scalar_argument\":1},{\"scalar_argument\":3}]],[\"no_condition\"],[\"acquired_exception_scope_v3\",{\"scalar_argument\":2},{\"scalar_argument\":3},{\"scalar_argument\":3}]],\"support_arguments\":[],\"support_from_terms\":[4],\"support_from_queries\":[]},{\"predicate\":\"emit_third_party_prohibition_v3\",\"term\":[\"prohibition\",[\"acquired_actor_v3\",{\"scalar_argument\":0}],[\"disclose\",[\"confidential_information\"],[\"third_parties\"]],[\"no_condition\"],[\"acquired_exception_scope_v3\",{\"scalar_argument\":1},{\"scalar_argument\":2},{\"scalar_argument\":2}]],\"support_arguments\":[],\"support_from_terms\":[3],\"support_from_queries\":[]},{\"predicate\":\"emit_source_residual_v3\",\"term\":[\"source_residual_observation_v3\",{\"scalar_argument\":0},{\"scalar_argument\":1}],\"support_arguments\":[],\"support_from_terms\":[2],\"support_from_queries\":[]},{\"predicate\":\"emit_employee_unconditioned_v3\",\"term\":[\"permission\",[\"receiving_party\"],[\"disclose\",[\"confidential_information\"],[\"employees_of\",[\"receiving_party\"]]],[\"no_condition\"]],\"support_arguments\":[],\"support_from_terms\":[0],\"support_from_queries\":[]},{\"predicate\":\"emit_complete_no_disposal_v4\",\"term\":[\"complete_source_no_disposal_obligation\"],\"support_arguments\":[],\"support_from_terms\":[0],\"support_from_queries\":[]},{\"predicate\":\"emit_complete_no_retention_v4\",\"term\":[\"complete_source_no_retention_effect\"],\"support_arguments\":[],\"support_from_terms\":[0],\"support_from_queries\":[]}]","source_function_edits":[{"code":"def sp_disclosure(spans,out,unresolved):\n    i=0\n    while i<len(spans):\n        uid=spans[i].get('id')\n        raw=spans[i].get('text','')\n        if not isinstance(raw,str):\n            raw=str(raw)\n        text=sp_low(raw)\n        context=sp_context(spans,i,2,1)\n        ctext=sp_low(context)\n        scope='unit:'+str(uid)\n        permission=sp_any(ctext,['may disclose','may be disclosed','will disclose','restrict disclosure','restrict access','except in confidence','except its employees','except its employees,','only to disclose','disclosed only to'])\n        elliptical='obligations of the parties' in text and 'need to know' in text and not permission\n        if elliptical:\n            roles=[]\n            if sp_any(text,['employee','staff','personnel']):\n                roles.append('employee')\n            if 'agent' in text:\n                roles.append('agent')\n            if 'representative' in text:\n                roles.append('representative')\n            for role in sp_unique(roles):\n                sp_add(out,['acq_disclosure_v3',scope,'elliptical_recipient_permission_residual','receiving_party',role,'receiving_party','required','not_stated','required','source_stated_ellipsis',raw],[uid])\n            if sp_any(text,['affiliate','any other individual','any other entity']):\n                sp_add(out,['acq_disclosure_v3',scope,'elliptical_recipient_permission_residual','receiving_party','source_bounded_recipient','source_bounded','required','not_stated','required','source_stated_ellipsis',raw],[uid])\n        need='required' if sp_any(ctext,['need to know','need-to-know','bona fide need']) else 'not_stated'\n        extent='required' if sp_any(ctext,['extent necessary','extent absolutely necessary','strictly necessary','strictly necessary for','reasonably necessary','disclosure is necessary','involved in the performance']) else 'not_stated'\n        confidentiality='written_required' if sp_any(ctext,['bound in writing','written agreement','written confidentiality agreement','mandatory non-disclosure agreement']) else 'required' if sp_any(ctext,['subject to the provisions','advise such employees','duty of confidentiality','bound by obligations','terms no less stringent','treat the confidential information']) else 'not_stated'\n        effect='class_permission' if 'except' in ctext else 'operative_permission'\n        actor='Auditor' if 'auditor shall' in text else 'Visitor' if 'visitor' in text else 'receiving_party'\n        if permission:\n            recipient_employee_coordination=sp_any(text,['employees or contractors of the recipient','employees and contractors of the recipient','employees and/or contractors of the recipient','employee or contractor of the recipient','contractors or employees of the recipient','contractors and employees of the recipient','contractors and/or employees of the recipient'])\n            direct_employee=sp_any(text,[\"recipient’s employees\",\"recipient's employees\",'its employees','members of its staff','employees, officers','employees and/or consultants','except its employees','only to such employees','only to employees']) or recipient_employee_coordination\n            controlled_employee=sp_any(text,['employees of companies directly or indirectly owned or controlled','employees, officials, representatives and agents of any legal entity that it controls','under common control'])\n            if direct_employee:\n                sp_add(out,['acq_disclosure_v3',scope,effect,actor,'employee','receiving_party',need,extent,confidentiality,'source_stated_exception',raw],[uid])\n            if controlled_employee:\n                sp_add(out,['acq_disclosure_v3',scope,effect,actor,'employee','controlled_entity',need,extent,confidentiality,'source_stated_exception',raw],[uid])\n            if 'consultant' in text:\n                sp_add(out,['acq_disclosure_v3',scope,effect,actor,'consultant','receiving_party',need,extent,confidentiality,'source_stated_exception',raw],[uid])\n            if 'contractor' in text:\n                sp_add(out,['acq_disclosure_v3',scope,effect,actor,'contractor','receiving_party',need,extent,confidentiality,'source_stated_exception',raw],[uid])\n            if 'agent' in text:\n                sp_add(out,['acq_disclosure_v3',scope,effect,actor,'agent','receiving_party',need,extent,confidentiality,'source_stated_exception',raw],[uid])\n            if sp_any(text,['professional adviser','professional advisor','advisors','advisers','legal advisor','legal adviser','financial advisor','financial adviser']):\n                sp_add(out,['acq_disclosure_v3',scope,effect,actor,'professional_adviser','receiving_party',need,extent,confidentiality,'source_stated_exception',raw],[uid])\n            if 'representatives' in text and not sp_any(text,['employees','consultants','contractors','agents','advisers','advisors']):\n                sp_add(out,['acq_disclosure_v3',scope,effect,actor,'representative','receiving_party',need,extent,confidentiality,'source_stated_exception',raw],[uid])\n        prohibited=sp_any(text,['shall not disclose','not disclose','will not without','not without']) and sp_any(text,['others','other person','other organization','third party','third parties','anyone'])\n        if prohibited and not permission:\n            exception='authorization' if sp_any(text,['consent','written approval','written authorization']) else 'source_stated_exception'\n            sp_add(out,['acq_disclosure_v3',scope,'bounded_prohibition',actor,'source_outsiders','source_bounded','not_stated','not_stated','not_stated',exception,raw],[uid])\n            if sp_any(text,['anyone','third party','third parties']):\n                sp_add(out,['acq_disclosure_v3',scope,'bounded_prohibition',actor,'third_parties','source_bounded','not_stated','not_stated','not_stated',exception,raw],[uid])\n        i+=1","name":"sp_disclosure"}],"suggested_rule_ids":["retain_existing_roots_v3","read_action_v3","read_link_v3","read_retention_v3","read_disclosure_v3","read_residual_v3","read_complete_source_absence_v4","compose_atomic_return_v3","compose_atomic_destroy_v3","compose_linked_alternative_v3","compose_linked_conjunction_v3","compose_retention_permission_v3","compose_retention_prohibition_v3","compose_permission_employee_v3","compose_permission_controlled_employee_v3","compose_permission_consultant_v3","compose_permission_contractor_v3","compose_permission_agent_v3","compose_permission_adviser_v3","compose_permission_representative_v3","compose_bounded_prohibition_v3","compose_third_party_prohibition_v3","compose_source_residual_v3","compose_complete_no_disposal_v4","compose_complete_no_retention_v4"]}}
