pan.get('text','')\n        if not isinstance(raw,str):\n            raw=str(raw)\n        text=sp_low(raw)\n        checked=text.replace('return receipt requested','').replace('returning the enclosed copy of this agreement','')\n        checked=checked.replace('returning the signed copy of this agreement','')\n        if re.search(r'\\b(return|returned|destroy|destroyed|destruction|delete|deleted|erase|erased)\\b',checked,re.I) is not None:\n            disposal_clear=False\n        if sp_any(text,['may retain','entitled to retain','permitted to retain','retain a record copy','required to retain','without retaining any copies','no copy shall be retained','no copies or records thereof shall be retained']):\n            retention_clear=False\n        if ('after' in text or 'following' in text or 'notwithstanding' in text) and sp_any(text,['return','destroy','destruction']) and sp_any(text,['retain','retained','retention']):\n            retention_clear=False\n    return [disposal_clear,retention_clear]","name":"sp_complete_source_absence_review"},{"code":"def sp_disclosure(spans,out,unresolved):\n    i=0\n    while i<len(spans):\n        uid=spans[i].get('id')\n        raw=spans[i].get('text','')\n        if not isinstance(raw,str):\n            raw=str(raw)\n        text=sp_low(raw)\n        context=sp_context(spans,i,2,1)\n        ctext=sp_low(context)\n        scope='unit:'+str(uid)\n        permission=sp_any(ctext,['may disclose','may be disclosed','will disclose','restrict disclosure','restrict access','except in confidence','except its employees','except its employees,','only to disclose','disclosed only to'])\n        elliptical='obligations of the parties' in text and 'need to know' in text and not permission\n        if elliptical:\n            roles=[]\n            if sp_any(text,['employee','staff','personnel']):\n                roles.append('employee')\n            if 'agent' in text:\n                roles.append('agent')\n            if 'representative' in text:\n                roles.append('representative')\n            for role in sp_unique(roles):\n                sp_add(out,['acq_disclosure_v3',scope,'elliptical_recipient_permission_residual','receiving_party',role,'receiving_party','required','not_stated','required','source_stated_ellipsis',raw],[uid])\n            if sp_any(text,['affiliate','any other individual','any other entity']):\n                sp_add(out,['acq_disclosure_v3',scope,'elliptical_recipient_permission_residual','receiving_party','source_bounded_recipient','source_bounded','required','not_stated','required','source_stated_ellipsis',raw],[uid])\n        need='required' if sp_any(ctext,['need to know','need-to-know','bona fide need']) else 'not_stated'\n        extent='required' if sp_any(ctext,['extent necessary','extent absolutely necessary','strictly necessary','reasonably necessary','disclosure is necessary','involved in the performance']) else 'not_stated'\n        confidentiality='written_required' if sp_any(ctext,['bound in writing','written agreement','written confidentiality agreement','mandatory non-disclosure agreement']) else 'required' if sp_any(ctext,['subject to the provisions','advise such employees','duty of confidentiality','bound by obligations','terms no less stringent','treat the confidential information']) else 'not_stated'\n        effect='class_permission' if 'except' in ctext else 'operative_permission'\n        actor='Auditor' if 'auditor shall' in text else 'Visitor' if 'visitor' in text else 'receiving_party'\n        if permission:\n            direct_employee=sp_any(text,[\"recipient’s employees\",\"recipient's employees\",'its employees','members of its staff','employees, officers','employees and/or consultants','except its employees'])\n            controlled_employee=sp_any(text,['employees of companies directly or indirectly owned or controlled','employees, officials, representatives and agents of any legal entity that it controls','under common control'])\n            if direct_employee:\n                sp_add(out,['acq_disclosure_v3',scope,effect,actor,'employee','receiving_party',need,extent,confidentiality,'source_stated_exception',raw],[uid])\n            if controlled_employee:\n                sp_add(out,['acq_disclosure_v3',scope,effect,actor,'employee','controlled_entity',need,extent,confidentiality,'source_stated_exception',raw],[uid])\n            if 'consultant' in text:\n                sp_add(out,['acq_disclosure_v3',scope,effect,actor,'consultant','receiving_party',need,extent,confidentiality,'source_stated_exception',raw],[uid])\n            if 'contractor' in text:\n                sp_add(out,['acq_disclosure_v3',scope,effect,actor,'contractor','receiving_party',need,extent,confidentiality,'source_stated_exception',raw],[uid])\n            if 'agent' in text:\n                sp_add(out,['acq_disclosure_v3',scope,effect,actor,'agent','receiving_party',need,extent,confidentiality,'source_stated_exception',raw],[uid])\n            if sp_any(text,['professional adviser','professional advisor','advisors','advisers','legal advisor','legal adviser','financial advisor','financial adviser']):\n                sp_add(out,['acq_disclosure_v3',scope,effect,actor,'professional_adviser','receiving_party',need,extent,confidentiality,'source_stated_exception',raw],[uid])\n            if 'representatives' in text and not sp_any(text,['employees','consultants','contractors','agents','advisers','advisors']):\n                sp_add(out,['acq_disclosure_v3',scope,effect,actor,'representative','receiving_party',need,extent,confidentiality,'source_stated_exception',raw],[uid])\n        prohibited=sp_any(text,['shall not disclose','not disclose','will not without','not without']) and sp_any(text,['others','other person','other organization','third party','third parties'])\n        if prohibited and not permission:\n            exception='authorization' if sp_any(text,['consent','written approval','written authorization']) else 'source_stated_exception'\n            sp_add(out,['acq_disclosure_v3',scope,'bounded_prohibition',actor,'source_outsiders','source_bounded','not_stated','not_stated','not_stated',exception,raw],[uid])\n        i+=1","name":"sp_disclosure"},{"code":"def apply(inputs,premises):\n    spans=[]\n    for span in inputs.get('source_spans',[]):\n        if isinstance(span,dict):\n            spans.append(span)\n    old=inputs.get('source_output',{})\n    statements=[]\n    unresolved=[]\n    if isinstance(old,dict):\n        for row in old.get('statements',[]):\n            if isinstance(row,dict):\n                statements.append(row)\n        for item in old.get('unresolved',[]):\n            if isinstance(item,str) and item not in unresolved:\n                unresolved.append(item)\n    disposal_count=0\n    i=0\n    while i<len(spans):\n        uid=spans[i].get('id')\n        raw=spans[i].get('text','')\n        if not isinstance(raw,str):\n            raw=str(raw)\n        context=sp_context(spans,i,2,3)\n        if sp_disposal_candidate(raw,context):\n            positions=sp_action_positions(sp_low(raw))\n            kinds=[]\n            if positions[0]>=0:\n                kinds.append('return')\n            if positions[1]>=0:\n                kinds.append('destroy')\n            scope='unit:'+str(uid)\n            triggers={}\n            for kind in kinds:\n                triggers[kind]=sp_trigger(raw,context,kind)\n            linked=len(kinds)==2 and triggers.get('return')==triggers.get('destroy')\n            mode='linked' if linked else 'atomic'\n            exception=sp_exception(spans,i)\n            support=[uid]\n            support.extend(exception[3])\n            for kind in kinds:\n                action_id=scope+':'+kind\n                material=sp_material(raw,kind)\n                timing=sp_timing(raw,kind)\n                sp_add(statements,['acq_disposal_action_v3',scope,action_id,kind,mode,material,triggers.get(kind),timing,exception[0],exception[1],exception[2],raw],support)\n                disposal_count+=1\n                if triggers.get(kind)=='unresolved_trigger':\n                    unresolved.append('action trigger unresolved for '+action_id)\n            if len(kinds)==2:\n                connector='or' if ' or ' in sp_low(raw) else 'and' if ' and ' in sp_low(raw) else 'split_or'\n                if not linked:\n                    connector='split_or'\n                sp_add(statements,['acq_disposal_link_v3',scope,scope+':return',scope+':destroy',connector,raw],[uid])\n        i+=1\n    sp_retention(spans,statements)\n    sp_disclosure(spans,statements,unresolved)\n    if disposal_count==0:\n        review=sp_complete_source_absence_review(spans)\n        ids=[]\n        for span in spans:\n            ids.append(span.get('id'))\n        if review[0]:\n            sp_add(statements,['acq_complete_source_absence_v4','disposal_obligation'],ids)\n            if review[1]:\n                sp_add(statements,['acq_complete_source_absence_v4','post_disposal_retention_effect'],ids)\n        else:\n            source_text=inputs.get('source_text','')\n            if not isinstance(source_text,str):\n                source_text=str(source_text)\n            sp_add(statements,['acq_residual_v3','no_safely_composable_disposal_atom',source_text],ids)\n            unresolved.append('no disposal atom acquired; complete-source absence review did not establish absence')\n    complete=isinstance(old,dict) and bool(old.get('complete',False)) and len(sp_unique(unresolved))==0\n    return {'statements':statements,'complete':complete,'unresolved':sp_unique(unresolved)}","name":"apply"}],"suggested_rule_ids":["retain_existing_roots_v3","read_action_v3","read_link_v3","read_retention_v3","read_disclosure_v3","read_residual_v3","read_complete_source_absence_v4","compose_atomic_return_v3","compose_atomic_destroy_v3","compose_linked_alternative_v3","compose_linked_conjunction_v3","compose_retention_permission_v3","compose_retention_prohibition_v3","compose_permission_employee_v3","compose_permission_controlled_employee_v3","compose_permission_consultant_v3","compose_permission_contractor_v3","compose_permission_agent_v3","compose_permission_adviser_v3","compose_permission_representative_v3","compose_bounded_prohibition_v3","compose_source_residual_v3","compose_complete_no_disposal_v4","compose_complete_no_retention_v4"]}}
