{"arm":"ScopedAcquisition","core_correct":2,"core_views":2,"native_grade":1.0,"records":[{"field_support_ids":{"action":[30,31,32,33,34],"actor_role":[30,31,32,33,34],"direct_recipient_classes":[30,31,32,33,34],"direct_recipient_relation":[30,31,32,33,34],"qualified_access_classes":[30,31,32,33,34],"qualified_access_relation":[30,31,32,33,34]},"kind":"confidential_information_authorization","relation_semantics_verified":false,"source_evidence":[{"end":5599,"field":"source_text","id":30,"public_sentence_id":49,"start":5174,"text":"(a) Subject to the restrictions set forth below in this Section 4, each Party may disclose the other Party’s Confidential Information to its directors, officers, employees, legal advisors, financial advisors and accountants, each bound by obligations of confidentiality consistent with this Agreement, who have a bona fide need to know (“Representatives”), but only to the extent necessary to carry out the Business Purpose. "},{"end":5654,"field":"source_text","id":31,"public_sentence_id":50,"start":5599,"text":"Each Party agrees to instruct all such Representatives "},{"end":5728,"field":"source_text","id":32,"public_sentence_id":51,"start":5654,"text":"(i) of the identities of the Party’s other permitted Representatives, and "},{"end":6017,"field":"source_text","id":33,"public_sentence_id":52,"start":5728,"text":"(ii) not to disclose such Confidential Information to any third parties (including, without limitation, any clients, affiliates, subsidiaries, independent contractors, and consultants) other than the identified Representatives without the prior written permission of the Disclosing Party. "},{"end":6133,"field":"source_text","id":34,"public_sentence_id":53,"start":6017,"text":"The Receiving Party shall be responsible for the conduct and compliance of its Representatives under this Agreement."}],"support_ids":[30,31,32,33,34],"unresolved_fields":[],"values":{"action":"grant_access","actor_role":"receiving_party","direct_recipient_clas