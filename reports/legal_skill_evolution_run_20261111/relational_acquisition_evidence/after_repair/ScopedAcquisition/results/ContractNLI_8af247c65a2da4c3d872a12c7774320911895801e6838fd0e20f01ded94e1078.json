,"text":"(e) In assisting SHIRE in discussions and evaluations in connection with the Business Purpose, L.E.K. "},{"end":7211,"field":"source_text","id":41,"public_sentence_id":64,"start":7071,"text":"may be communicating with NEW RIVER employees, consultants, or contractors not identified as NEW RIVER Representatives on Exhibit C hereto. "},{"end":7246,"field":"source_text","id":42,"public_sentence_id":65,"start":7211,"text":"In all such communications, L.E.K. "},{"end":7496,"field":"source_text","id":43,"public_sentence_id":66,"start":7246,"text":"shall not disclose the name of its client or otherwise permit any communication or disclosure that could result in such NEW RIVER employees, consultants, or contractors identifying SHIRE as having any involvement in the work being performed by L.E.K."}],"support_ids":[35,36,37,38,40,41,42,43],"unresolved_fields":[],"values":{"action":"disclose","actor_role":"receiving_party","exception_recipient_classes":[],"exception_recipient_relation":"unspecified","exception_scope":"no_stated_exception","restricted_recipient_classes":["employee","director","officer","consultant","contractor","agent"],"restricted_recipient_scope":"specified_roles"}},{"field_support_ids":{"actor_role":[40,41,42,43],"linked_recipient_classes":[40,41,42,43],"linked_recipient_relation":[40,41,42,43],"target_action":[40,41,42,43]},"kind":"recipient_scope_link","relation_semantics_verified":false,"source_evidence":[{"end":7071,"field":"source_text","id":40,"public_sentence_id":63,"start":6969,"text":"(e) In assisting SHIRE in discussions and evaluations in connection with the Business Purpose, L.E.K. "},{"end":7211,"field":"source_text","id":41,"public_sentence_id":64,"start":7071,"text":"may be communicating with NEW RIVER employees, consultants, or contractors not identified as NEW RIVER Representatives on Exhibit C hereto. "},{"end":7246,"field":"source_text","id":42,"public_sentence_id":65,"start":7211,"text":"In all such communications, L.E.K. "},{"end