{"arm":"ScopedAcquisition","core_correct":2,"core_views":2,"native_grade":1.0,"records":[{"field_support_ids":{"action":[14,15,17,18],"actor_role":[14,15,17,18],"direct_recipient_classes":[14,15,17,18],"direct_recipient_relation":[14,15,17,18],"qualified_access_classes":[14,15,17,18],"qualified_access_relation":[14,15,17,18]},"kind":"confidential_information_authorization","relation_semantics_verified":false,"source_evidence":[{"end":1600,"field":"source_text","id":14,"public_sentence_id":14,"start":1328,"text":"The Receiving Party shall treat as strictly confidential any and all information disclosed to it by SINTEC and shall not disclose said information to third parties or use it for its own business purposes or for other customers without the prior written consent of SINTEC. "},{"end":1711,"field":"source_text","id":15,"public_sentence_id":15,"start":1600,"text":"The Receiving Par-ty shall use the information only for SINTEC's specified or authorized purposes in each case."},{"end":1966,"field":"source_text","id":17,"public_sentence_id":17,"start":1754,"text":"The Receiving Party will disclose information it receives from SINTEC only to selected members of its staff and only to the extent absolutely necessary for SINTEC's specified or authorized purposes in each case. "},{"end":2330,"field":"source_text","id":18,"public_sentence_id":18,"start":1966,"text":"To the extent permitted by law, the Receiving Party shall ensure that said employees are bound to a duty of confidentiality for the term of their respective employment relationship in accordance with the terms and conditions of this Agreement and that such duty of confidentiality shall survive the termination/expiration of the respective employment relationship."}],"support_ids":[14,15,17,18],"unresolved_fields":[],"values":{"action":"grant_access","actor_role":"receiving_party","direct_recipient_classes":["employee","director","officer","contractor","consultant","agent","legal_advisor","financial_advisor","pr