se,"call_id":"legal_skill_evolution_frozen_v1_20261111:4086cde923734a8b92fc7d12e1622fb4b59ea223bcb59fcb8c182968e18a1d9b","elapsed_seconds":8.871810786426067,"fields":{"asset_names":{"status":"known","support":[{"end":21296,"field":"original_input","id":75,"start":20880,"text":"Facts:\nSahil and Yusuf Singh (hereinafter the Debtors) filed for bankruptcy on 05-19-2024. The Debtors are the owners of both a designer trench coat with monogrammed lining and custom buttons valued at $2,300.00 and a modern steel metallic 2014 Honda CR-V EX-L with a value of $17,900.00. The large digital photo frame with auto-slideshow and remote control belonging to the Singhs has an appraisal value of $548.00."}],"support_ids":[75],"value":["designer trench coat with monogrammed lining and custom buttons","modern steel metallic 2014 Honda CR-V EX-L","large digital photo frame with auto-slideshow and remote control"]},"asset_values":{"status":"known","support":[{"end":21296,"field":"original_input","id":75,"start":20880,"text":"Facts:\nSahil and Yusuf Singh (hereinafter the Debtors) filed for bankruptcy on 05-19-2024. The Debtors are the owners of both a designer trench coat with monogrammed lining and custom buttons valued at $2,300.00 and a modern steel metallic 2014 Honda CR-V EX-L with a value of $17,900.00. The large digital photo frame with auto-slideshow and remote control belonging to the Singhs has an appraisal value of $548.00."}],"support_ids":[75],"value":[2300.0,17900.0,548.0]},"include_claim_values":{"status":"known","support":[{"end":21556,"field":"original_input","id":76,"start":21298,"text":"Output contract: Return only a JSON object: keys are the actual asset descriptions in Facts; values are arrays of all applicable public citation label IDs from the supplied vocabulary, or [] if none. Labels are only output encodings, not eligibility answers."}],"support_ids":[76],"value":true},"other_property_applies":{"status":"known","support":[{"end":9942,"field":"original_input","id":34,"start":8927,"text":"Illinois Compiled Statutes\n735 Ill. Comp. Stat. 5/12-901\nSec. 12-901. Amount. Every individual is entitled to an estate of homestead to the extent in value of $15,000 of his or her interest in a farm or lot of land and buildings thereon, a condominium, or personal property, owned or rightly possessed by lease or otherwise and occupied by him or her as a residence, or in a cooperative that owns property that the individual uses as a residence. That homestead and all right in and title to that homestead is exempt from attachment, judgment, levy, or judgment sale for the payment of his or her debts or other purposes and from the laws of conveyance, descent, and legacy. This Section is not applicable between joint tenants or tenants in common but it is applicable as to any creditors of those persons. If 2 or more individuals own property that is exempt as a homestead, the value of the exemption of each individual may not exceed his or her proportionate share of $30,000 based upon percentage of ownership."},{"end":11068,"field":"original_input","id":39,"start":10955,"text":"735 Ill. Comp. Stat. 5/12-1001(c)\nThe debtor's interest, not to exceed $2,400 in value, in any one motor vehicle;"},{"end":11568,"field":"original_input","id":42,"start":11360,"text":"735 Ill. Comp. Stat. 5/12-1001\nThe personal property exemptions set forth in this Section shall apply only to individuals and only to personal property that is used for personal rather than business purposes."}],"support_ids":[34,39,42],"value":[true,true,true]},"other_property_citation":{"status":"known","support":[{"end":10684,"field":"original_input","id":36,"start":10501,"text":"735 Ill. Comp. Stat. 5/12-1001\nSec. 12-1001. Personal property exempt. The following personal property, owned by the debtor, is exempt from judgment, attachment, or distress for rent:"}],"support_ids":[36],"value":"735 Ill. Comp. Stat. 5/12-1001(b)"},"other_property_limit":{"status":"known","support":[{"end":110