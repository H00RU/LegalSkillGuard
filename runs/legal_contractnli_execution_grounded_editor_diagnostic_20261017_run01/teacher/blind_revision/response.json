                  "evaluation material",
                  "copies",
                  "reproductions"
                ],
                "none_phrases": [],
                "include_list_preamble": true
              },
              {
                "all_phrases": [],
                "any_phrases": [
                  "upon termination",
                  "expiration or other termination",
                  "rejected or concluded",
                  "conclusion of the evaluation"
                ],
                "none_phrases": [],
                "include_list_preamble": true
              }
            ]
