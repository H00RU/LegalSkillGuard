  "fixed_M1_bank": [
    {
      "id": "termination-triggered-return",
      "hypothesis_ids": [
        "nda-16"
      ],
      "guidance": {
        "when": "The source expressly makes return or destruction of protected information operative upon termination, expiration, rejection, or conclusion of the agreement, project, or contemplated relationship.",
        "inspection": "Separate the operative return or destruction duty from request-only duties, then verify that the stated trigger is an ending event and carry forward any scope limits or exceptions.",
        "relation_if_established": "Entailment",
        "evidence_requirement": "Cite the ending-event trigger together with the operative return or destruction language; include a governing list introduction when the duty is an item.",
        "source_operations": [
          "list_preamble"
        ]
      }
    },
    {
      "id": "express-retention-carveout",
      "hypothesis_ids": [
        "nda-20"
      ],
      "guidance": {
        "when": "The source expressly exempts identified copies or stored protected information from a return or deletion duty and permits their continued retention.",
        "inspection": "Read the general return or destruction rule with every overriding exception; identify what may remain, who or what system may hold it, its purpose, and continuing restrictions.",
        "relation_if_established": "Entailment",
        "evidence_requirement": "Cite the retention permission and any governing exception transition, plus material limits such as archival-only access, dispute purpose, or continuing confidentiality.",
        "source_operations": [
          "list_preamble"
        ]
      }
    },
    {
      "id": "negotiation-existence-secrecy",
      "hypothesis_ids": [
        "nda-10"
      ],
      "guidance": {
        "when": "The source expressly prohibits disclosure of the existence or occurrence of negotiations, discussions, an agreement in progress, receipt of evaluation material, or terms or status of the contemplated transaction.",
        "inspection": "Distinguish secrecy of the deal process or agreement facts from ordinary secrecy of confidential information, and preserve consent, audience, and publicity qualifications.",
        "relation_if_established": "Entailment",
        "evidence_requirement": "Cite the prohibition's governing language and each relied-on enumerated subject; a generic nondisclosure clause alone is insufficient.",
        "source_operations": [
          "list_preamble"
        ]
      }
    },
    {
      "id": "copy-clause-polarity-inspection",
      "hypothesis_ids": [
        "nda-17"
      ],
      "guidance": {
        "when": "A source clause expressly addresses making, reproducing, automatically creating, returning, destroying, or retaining copies of protected information.",
        "inspection": "Classify the copy language by legal function: affirmative exception, automatic-copy acknowledgement, consent-conditioned prohibition, mere reference to existing copies, return duty, or retention carve-out. Do not infer creation permission from employee access or generic safeguarding.",
        "relation_if_established": null,
        "evidence_requirement": "Cite the operative copy wording and its governing condition or exception; read adjacent retention or return language when it changes the clause's function.",
        "source_operations": [
          "list_preamble"
        ]
      }
    },
    {
      "id": "express-no-rights-grant",
      "hypothesis_ids": [
        "nda-15"
      ],
      "guidance": {
        "when": "The source expressly states that the agreement or disclosure grants, conveys, or confers no right or license in protected information or associated intellectual property.",
        "inspection": "Identify the denied grant separately from ownership, limited-purpose use, and review permissions; preserve any express narrow exception without treating it as a general license.",
        "relation_if_established": "Entailment",
        "evidence_requirement": "Cite the operative no-rights or no-license wording and any material exception; ownership language may be retained as independent support but is not a substitute for an express grant denial.",
        "source_operations": []
      }
    },
    {
      "id": "stated-purpose-only-use",
      "hypothesis_ids": [
        "nda-4"
      ],
      "guidance": {
        "when": "The source expressly limits use of protected information to a stated agreement, transaction, evaluation, project, discussion, or business-relationship purpose, whether phrased as 'only' or as a prohibition with a necessary-purpose exception.",
        "inspection": "Treat the permitted purpose as the boundary of the restriction, not as permission for unrelated uses; capture both affirmative only-use wording and complementary other-purpose prohibitions.",
        "relation_if_established": "Entailment",
        "evidence_requirement": "Cite the operative use limitation and the text identifying the permitted purpose; include a governing introduction when the rule is listed.",
        "source_operations": [
          "list_preamble"
        ]
      }
    }
  ],
