        "skill": {
          "id": "nda-return-copy-retention-evidence",
          "hypothesis_ids": [
            "nda-16"
          ],
          "guidance": {
            "inspection": "Entail only when return or destruction is mandatory upon termination, expiration, rejection, conclusion, or ceasing interest. A request-only duty remains NotMentioned even if termination is addressed elsewhere; never join separate triggers. Retain actor, object, action, trigger, and governing preamble.",
            "source_queries": [
              {
                "all_phrases": [
                  "return"
                ],
                "any_phrases": [
                  "upon termination",
                  "on termination",
                  "expiration",
                  "rejected or concluded",
                  "conclusion of",
                  "ceasing to be interested",
                  "cannot be further developed"
                ],
                "none_phrases": [],
                "include_list_preamble": true
              },
              {
                "all_phrases": [
                  "destroy"
                ],
                "any_phrases": [
                  "upon termination",
                  "on termination",
                  "expiration",
                  "rejected or concluded",
                  "conclusion of",
                  "ceasing to be interested"
                ],
                "none_phrases": [],
                "include_list_preamble": true
              },
              {
                "all_phrases": [
                  "deleted"
                ],
                "any_phrases": [
                  "termination",
                  "expiration",
                  "membership termination"
                ],
                "none_phrases": [],
                "include_list_preamble": true
              }
            ]
          }
        },
        "source_case_ids": [
          490,
          416,
          261,
          159
        ],
        "rationale": "The observed contrast establishes that a request-only return duty does not settle the termination-triggered hypothesis, while conclusion, ceasing-interest, and termination-linked duties do."
      },
