{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["annotations"],
  "properties": {
    "annotations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_case_sha256", "case", "provenance"],
        "properties": {
          "source_case_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "case": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "jurisdiction", "language", "opening", "facts", "evaluation_criteria"],
            "properties": {
              "id": {"type": "string", "pattern": "^lsg_cn_[0-9]{4}$"},
              "jurisdiction": {"type": "string", "const": "CN"},
              "language": {"type": "string", "const": "zh"},
              "opening": {"type": "string", "minLength": 15, "maxLength": 180},
              "facts": {
                "type": "array", "minItems": 6, "maxItems": 12,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["fact_id", "client_belief", "court_record", "gap_type"],
                  "properties": {
                    "fact_id": {"type": "string", "pattern": "^F[1-9][0-9]?$"},
                    "client_belief": {"type": "string", "minLength": 12, "maxLength": 500},
                    "court_record": {"type": "string", "minLength": 12, "maxLength": 650},
                    "gap_type": {"type": "string", "enum": ["disputed", "undisputed"]}
                  }
                }
              },
              "evaluation_criteria": {
                "type": "object", "additionalProperties": false,
                "required": ["expected_inquiries", "memo_expectations"],
                "properties": {
                  "expected_inquiries": {
                    "type": "array", "minItems": 5, "maxItems": 9,
                    "items": {"type": "string", "minLength": 12, "maxLength": 300}
                  },
                  "memo_expectations": {
                    "type": "array", "minItems": 4, "maxItems": 8,
                    "items": {"type": "string", "minLength": 12, "maxLength": 350}
                  }
                }
              }
            }
          },
          "provenance": {
            "type": "object", "additionalProperties": false,
            "required": ["legal_domain", "client_role", "fact_support", "legal_time_note", "quality_flags"],
            "properties": {
              "legal_domain": {
                "type": "string",
                "enum": ["marriage_family", "labor_employment", "consumer_contract", "contract_commercial", "company_commercial", "intellectual_property", "personality_privacy", "administrative", "environment_resources", "criminal", "procedure_evidence"]
              },
              "client_role": {"type": "string", "minLength": 2, "maxLength": 60},
              "fact_support": {
                "type": "array", "minItems": 6, "maxItems": 12,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["fact_id", "quotes"],
                  "properties": {
                    "fact_id": {"type": "string", "pattern": "^F[1-9][0-9]?$"},
                    "quotes": {
                      "type": "array", "minItems": 1, "maxItems": 3,
                      "items": {
                        "type": "object", "additionalProperties": false,
                        "required": ["section", "quote"],
                        "properties": {
                          "section": {"type": "string", "enum": ["basic_facts", "adjudication"]},
                          "quote": {"type": "string", "minLength": 6, "maxLength": 260}
                        }
                      }
                    }
                  }
                }
              },
              "legal_time_note": {"type": "string", "minLength": 2, "maxLength": 260},
              "quality_flags": {
                "type": "array", "maxItems": 8,
                "items": {"type": "string", "maxLength": 160}
              }
            }
          }
        }
      }
    }
  }
}
