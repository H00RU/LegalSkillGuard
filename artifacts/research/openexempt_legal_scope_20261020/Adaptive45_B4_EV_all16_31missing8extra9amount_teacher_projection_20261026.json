  "reproduction_program": "import json,collections\nfrom pathlib import Path\nfrom datetime import datetime,timezone\nfrom legal_skill_guard.openexempt import upstream\nroot=Path.cwd();p=root/'runs/legal_openexempt_adaptive_legal_public_assets128_20261026_run01'\ncfg=json.loads((root/'configs/openexempt_adaptive_legal_public_assets128_20261026_run01.json').read_text())\nrs=json.loads((p/'batches/b4_prequential_records.json').read_text())\nEvaluator=upstream('evaluator').Evaluator;Claim=upstream('source.pydantic_response').Claim;e=Evaluator([])\nout={'at':datetime.now(timezone.utc).isoformat(),'classification':'B4 all16 EV diagnostic error atoms using original asset matcher and 5percent native amount criterion; not a replacement metric','arms':{},'no_extra_model_teacher_solver_calls':True}\nfor arm in ('skills','frozen_after_B1'):\n total=collections.Counter();per=[]\n for r in rs[arm]:\n  if r['family']!='EV':continue\n  target=json.loads((root/cfg['grading_directory']/f\"{r['case_id']}.json\").read_text())['targets']['EV']\n  answer=r['parsed']['answer'];pred={k.strip().lower():v for k,v in answer.items()};used=set();c=collections.Counter();details=[]\n  for name,ts in target.items():\n   match=e._find_matching_asset_description(name.strip().lower(),list(pred))\n   ps=pred[match] if match is not None and match not in used else []\n   if match is not None:used.add(match)\n   tmap={Claim(**v).normalized_citation:v for v in ts};pmap={Claim(**v).normalized_citation:v for v in ps}\n   missing=sorted(set(tmap)-set(pmap));extra=sorted(set(pmap)-set(tmap));wrong=[]\n   for citation in set(tmap)&set(pmap):\n    _,error=e._find_matching_claim(Claim(**pmap[citation]),[Claim(**tmap[citation])])\n    if error is None or error>=0.05:wrong.append({'citation':citation,'target_value':tmap[citation]['claim_value'],'submitted_value':pmap[citation]['claim_value'],'relative_error':error})\n   c.update({'target_claims':len(ts),'submitted_claims':len(ps),'missing_citation_pairs':len(missing),'extra_citation_pairs':len(extra),'same_citation_wrong_amount_pairs':len(wrong),'same_citation_native_correct_amount_pairs':len(set(tmap)&set(pmap))-len(wrong)})\n   if missing or extra or wrong:details.append({'asset':name,'missing':missing,'extra':extra,'correct_citation_wrong_amount':sorted(wrong,key=lambda v:v['citation'])})\n  unmatched={name:claims for name,claims in pred.items() if name not in used and claims}\n  c['unmatched_asset_claims']=sum(len(v) for v in unmatched.values())\n  total.update(c)\n  per.append({'case_id':r['case_id'],'native_f1':r['score']['f1'],'counts':dict(c),'errors':details,'unmatched_asset_claims':unmatched,'raw_call_path':r['raw_call_path']})\n out['arms'][arm]={'totals':dict(total),'per_source':per}\nprint(json.dumps(out,ensure_ascii=False))\n",
