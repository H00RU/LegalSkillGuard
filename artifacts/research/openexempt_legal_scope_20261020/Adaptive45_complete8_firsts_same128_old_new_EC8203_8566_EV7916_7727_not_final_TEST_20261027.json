  "reproducer_readonly_python": "import json,hashlib\nfrom pathlib import Path\nfrom datetime import datetime,timezone\nfrom experiments.openexempt_online import paired_effect\nfrom legal_skill_guard.openexempt import metrics\nroot=Path.cwd();newcfg=root/'configs/openexempt_adaptive_legal_public_assets128_20261026_run01.json'\nnew=json.loads(newcfg.read_text());np=root/'runs'/new['run_id']\nif not ((np/'batches/b8_prequential_records.json').exists() and (np/'batches/b8_prequential.json').exists()):\n print('{\"waiting_for_complete_new_B8_firsts_before_any_old_new_comparison\":true}');raise SystemExit(0)\nhistorical=json.loads((root/'artifacts/research/openexempt_legal_scope_20261020/Adaptive45_original_v023_full8_TRAIN_firsts_comparator_same128_20261027.json').read_text())\nold=json.loads((root/historical['old_source_config']).read_text());op=root/'runs'/old['run_id']\nassert old['input_packet']==new['input_packet'] and old['generation']==new['generation']\nrows=json.loads((root/new['input_packet']).read_text())['rows'];assert len(rows)==256\ncomplete={run:{role:[] for role in ('skills','empty','frozen_after_B1')} for run in ('old','new')}\nbatches=[]\nfor b in range(1,9):\n sources={(r['case_id'],r['family']) for r in rows if r['batch']==b};assert len(sources)==32\n origins={};pre={}\n for run,p in (('old',op),('new',np)):\n  path=p/f'batches/b{b}_prequential_records.json';rs=json.loads(path.read_text());pre[run]=json.loads((p/f'batches/b{b}_prequential.json').read_text());origins[run]=rs\n  if run=='old':assert hashlib.sha256(path.read_bytes()).hexdigest()==historical['all8_old_batches'][b-1]['original_records_sha256']\n  for role in complete[run]:\n   assert len(rs[role])==32 and {(r['case_id'],r['family']) for r in rs[role]}==sources\n   value=metrics(rs[role]);assert all(abs(value[f]['f1']-pre[run][role][f]['f1'])<1e-12 for f in ('EC','EV'))\n   complete[run][role].extend(rs[role])\n diffs={f:paired_effect([r for r in origins['old']['skills'] if r['family']==f],[r for r in origins['new']['skills'] if r['family']==f]) for f in ('EC','EV')}\n banks={}\n for run,p in (('old',op),('new',np)):\n  pub=p/f'publications/b{b}.json'\n  banks[run]={'main_parent_records_at_forecast':pre[run]['parent_skill_count'],'parent_bank_sha256':pre[run]['parent_bank_sha256'],'publication_after_batch_exists':pub.exists(),'published_records_after':len(json.loads(pub.read_text())['bank']) if pub.exists() else None}\n batches.append({'batch':b,'source_cases':16,'old_main_EC_EV_percent':[100*pre['old']['skills'][f]['f1'] for f in ('EC','EV')],'new_main_EC_EV_percent':[100*pre['new']['skills'][f]['f1'] for f in ('EC','EV')],'new_minus_old_pp':[100*diffs[f]['mean_f1_difference'] for f in ('EC','EV')],'same_case_old_new_effects':diffs,'old_ownB1_EC_EV_percent':[100*pre['old']['frozen_after_B1'][f]['f1'] for f in ('EC','EV')],'new_ownB1_EC_EV_percent':[100*pre['new']['frozen_after_B1'][f]['f1'] for f in ('EC','EV')],'old_empty_EC_EV_percent':[100*pre['old']['empty'][f]['f1'] for f in ('EC','EV')],'new_empty_EC_EV_percent':[100*pre['new']['empty'][f]['f1'] for f in ('EC','EV')],'actual_bank_boundaries':banks})\neffects={f:paired_effect([r for r in complete['old']['skills'] if r['family']==f],[r for r in complete['new']['skills'] if r['family']==f]) for f in ('EC','EV')}\ngain={}\nfor run,arms in complete.items():\n gain[run]={c:{f:paired_effect([r for r in arms[c] if r['family']==f],[r for r in arms['skills'] if r['family']==f]) for f in ('EC','EV')} for c in ('empty','frozen_after_B1')}\nprint(json.dumps({'at':datetime.now(timezone.utc).isoformat(),'classification':'Complete eight-cohort same-source first-forecast comparison; not final learned-bank TEST or proof that new learning updates finished','old_run_id':old['run_id'],'new_run_id':new['run_id'],'same_TRAIN_packet_order_generation':True,'all8_batch_firsts':batches,'full128_firstforecast_metrics':{run:{role:metrics(rs) for role,rs in arms.items()} for run,arms in complete.items()},'new_minus_old_same_source_effects':effects,'each_run_relative_own_controls':gain,'full_new_training_completion_exists':(np/'completion.json').exists(),'learning_serial_vs_four_native_and_source_epoch_confound_retained':True,'no_partial_B8_data_filtering_or_missing_denominators':True,'no_TEST_questions_targets_predictions_scores_read':True,'no_new_model_teacher_tokenizer_native_grader_or_symbolic_solver_call':True},ensure_ascii=False))\n"
