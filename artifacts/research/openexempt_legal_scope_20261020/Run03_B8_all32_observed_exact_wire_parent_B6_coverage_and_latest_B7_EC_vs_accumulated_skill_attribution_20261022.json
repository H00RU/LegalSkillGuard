score\"]) and q==req for _,v,q in matches)\n q=read(root/by[\"skills\"][key][\"raw_call_path\"])[\"calls\"][0][\"request\"];assert {k:v for k,v in q.items() if k!=\"messages\"}=={k:v for k,v in req.items() if k!=\"messages\"}\n members.add(by[\"skills\"][key][\"raw_call_path\"]);projected_records.append(z)\n effect=by[\"skills\"][key][\"score\"][\"f1\"]-z[\"score\"][\"f1\"]\n x={\"source\":key[0],\"family\":key[1],\"public_namespaces\":sorted(e.allowable_namespaces(row)),\"B7_changes_payload_vs_B6\":(pm,ps)!=(cm,cs),\"matching_observed_roles\":[r for r,_,_ in matches],\"actual_parent_wire_origin\":z[\"raw_call_path\"],\"actual_current_wire_origin\":by[\"skills\"][key][\"raw_call_path\"],\"parent_native_F1\":z[\"score\"][\"f1\"],\"current_native_F1\":by[\"skills\"][key][\"score\"][\"f1\"],\"native_F1_difference_pp\":100*effect}\n covered.append(x)\n if x[\"B7_changes_payload_vs_B6\"]:\n  assert key[1]==\"EC\" and \"ILLINOIS\" in e.allowable_namespaces(row);changed.append(x)\nassert not uncovered and len(covered)==32 and len(projected_records)==32\nsource_ds=[sum(x[\"native_F1_difference_pp\"] for x in covered if x[\"source\"]==i)/2 for i in range(293,309)]\ncontexts=collections.defaultdict(list)\nfor i in range(293,309):contexts[\"+\".join(sorted(e.allowable_namespaces(rows[i,\"EC\"])))].append(i)\nallcontexts=[]\nfor group,ids in sorted(contexts.items()):\n diff={f:sum(100*(by[\"skills\"][i,f][\"score\"][\"f1\"]-by[\"frozen_after_B1\"][i,f][\"score\"][\"f1\"]) for i in ids)/len(ids) for f in e.FAMILIES}\n allcontexts.append({\"context\":group,\"all_source_ids\":ids,\"sources\":len(ids),\"online_vs_ownB1_mean_pp\":diff,\"contribution_to_all16_pp\":{f:diff[f]*len(ids)/16 for f in e.FAMILIES}})\nout={\"at\":now(),\"classification\":\"B8 TRAIN process attribution using all32 parent-B6 native request payloads covered exactly by already observed currentB8 control/treatment wires. No new B6 role, generated answer, performance-dependent role choice or independent replication. Fixed-wire conditional diagnostic only.\",\"all32_original_B6_parent_payloads_match_observed_roles\":True,\"all_matches_identical_answer_score_request\":True,\"uncovered\":uncovered,\"parent_B6_bank_sha256\":csha(parent),\"current_B7_bank_sha256\":csha(current),\"exactly_covered_tasks\":covered,\"B7_actual_changed_payload_tasks\":changed,\"parent_B6_equivalent_observed_metrics\":metrics(projected_records),\"current_B7_metrics\":metrics(records[\"skills\"]),\"B7_increment_vs_parent_B6_native_pp\":{f:100*(metrics(records[\"skills\"])[f][\"f1\"]-metrics(projected_records)[f][\"f1\"]) for f in e.FAMILIES},\"task_effect\":e.paired_effect(projected_records,records[\"skills\"]),\"source_effect\":{\"sources\":16,\"help\":sum(x>1e-10 for x in source_ds),\"hurt\":sum(x< -1e-10 for x in source_ds),\"tie\":sum(abs(x)<=1e-10 for x in source_ds),\"mean_family_pp\":sum(source_ds)/16},\"all_public_context_groups_online_vs_ownB1\":allcontexts,\"boundary\":\"The B6-equivalent outputs were not newly generated. Input equality, not scores, determines reuse; complete coverage is required. Distinguishes latest IL EC edit from accumulated Oregon/EV changes. Does not identify semantic single-phrase causality or population effects.\",\"new_actor_teacher_TEST_calls\":0,\"no_source_score_or_runtime_change\":True,\"evidence_paths\":sorted(members),\"audit_recomputation_program\":PROGRAM}\ndest=base/\"Run03_B8_all32_observed_exact_wire_parent_B6_coverage_and_latest_B7_EC_vs_accumulated_skill_attribution_20261022.json\";RunStore.immutable_json(dest,out)\nprint(json.dumps({\"report\":str(dest.relative_to(root)),\"at\":out[\"at\"],\"latest_B7_EC_increment_pp\":out[\"B7_increment_vs_parent_B6_native_pp\"],\"changed_task_cases\":[x[\"source\"] for x in changed],\"changed_task_effects\":changed,\"source_effect\":out[\"source_effect\"],\"contexts\":allcontexts},ensure_ascii=False))\n"
