  "recomputation_program": "from pathlib import Path\nfrom datetime import datetime,timezone\nfrom collections import Counter\nimport json,hashlib\nfrom experiments.openexempt_online import actor_payload,acceptance\nfrom legal_skill_guard.openexempt import metrics\nfrom legal_skill_guard.utils.hashing import canonical_json_sha256 as csha\nroot=Path.cwd();run=root/'runs/legal_openexempt_whole_bank_public_assets128_phase4_20261025_run02'\nread=lambda p:json.loads(p.read_text());sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()\ncfg=read(root/'configs/openexempt_whole_bank_public_assets128_phase4_20261025_run02.json')\ncp=run/'candidates/b1_candidate1.json';c=read(cp);first=read(run/'batches/b1_prequential_records.json')['skills'];after=c['actual_replay']\nbank=c['candidate'];assert c['accepted'] and len(bank)==5 and c['actual_tokens']==1884\nassert {s['id']:s for s in bank}=={s['id']:s for s in c['proposed_bank']}\nassert c['attempt_parent_bank_sha256']==csha([])\nderived=acceptance(first,after,[],[]);assert derived['accepted']\nassert all(c[k]==v for k,v in derived.items())\npacket=read(root/cfg['input_packet']);rows={(r['case_id'],r['family']):r for r in packet['rows'] if r['case_id'] in range(181,197)}\nexpected=set(rows);origins=set();paths=set();usage=Counter();finishes=Counter();fingerprints=set()\nfor replay,view_bank in [(c['proposed_replay'],c['proposed_bank']),(after,bank)]:\n assert len(replay)==32 and {(a['case_id'],a['family']) for a in replay}==expected\n for a in replay:\n  p=run/f\"native/{a['stage']}/{a['case_id']}_{a['family']}_{a['arm']}.input.json\";d=read(p)\n  messages,schema,supplied=actor_payload(rows[a['case_id'],a['family']],view_bank,grounded=True,direct_numeric=True,asset_references=True)\n  assert d['messages']==messages and d['schema']==schema\n  assert a['bank_sha256']==d['bank_sha256']==csha(view_bank)\n  assert d['delivered_skill_ids']==a['delivered_skill_ids']==[s['id'] for s in supplied] and supplied\n  raw=read(root/a['raw_call_path']);assert len(raw['calls'])==1 and not raw['transport_error']\n  call=raw['calls'][0];q=call['request']\n  assert q['messages']==messages and q['response_format']['json_schema']['schema']==schema\n  assert all(q[k]==cfg['generation'][k] for k in ['model','seed','max_tokens','temperature','top_p','top_k'])\n  assert json.loads(call['response']['choices'][0]['message']['content'])==a['public_label_submission']\n  assert a['native_program'] is None and a['execution_receipt'] is None\n  paths.update([str(p.relative_to(root)),str(p.with_name(p.name.replace('.input.json','.answer.json')).relative_to(root)),a['raw_call_path']]);origins.add(a['raw_call_path'])\nassert len(origins)==32 and len(paths)==160\nfor n in origins:\n w=read(root/n)['calls'][0]['response'];finishes[w['choices'][0]['finish_reason']]+=1;usage['input_tokens']+=w['usage']['prompt_tokens'];usage['output_tokens']+=w['usage']['completion_tokens']\nassert finishes=={'stop':32}\nb={(a['case_id'],a['family']):a for a in first};harms=[{'source':a['case_id'],'family':a['family'],'before':b[a['case_id'],a['family']]['score']['f1'],'after':a['score']['f1']} for a in after if a['score']['f1']<b[a['case_id'],a['family']]['score']['f1']-1e-12]\nassert len(harms)==3\nwp=run/'teacher/b1_candidate2/wire_request.json';rp=run/'teacher/b1_candidate2/response.json';w=read(wp);response=read(rp);body=json.loads(w['user_prompt'])\nassert csha(body['current_parent_library'])==csha(bank)\nby={(a['case_id'],a['family']):a for a in after}\nfor item in body['already_seen_training']:\n k=item['source_case_id'],item['family'];a=by[k]\n assert item['actual_parent_answer']['score']==a['score'] and item['actual_parent_answer']['executed_answer']==(a['parsed'] or {}).get('answer')\n assert item['original_training_target']==read(root/cfg['grading_directory']/f'{k[0]}.json')['targets'][k[1]]\nassert len(body['already_seen_training'])==32\nsource_files=[cp,run/'batches/b1_prequential_records.json',run/'teacher/b1_candidate1/wire_request.json',run/'teacher/b1_candidate1/response.json',run/'teacher/b1_candidate1/event_log.json',wp,rp,run/'teacher/b1_candidate2/event_log.json']\nresult={'at':datetime.now(timezone.utc).isoformat(),'classification':'Complete B1 C1 full32 TRAIN replay accepted5records1884tokens; labelled current-source fitting, NOT future-case learning gain/final B1 publication/control/TEST','bank_sha256':csha(bank),'proposed_bank_sha256':csha(c['proposed_bank']),'record_order_only_normalization_no_payload_change':True,'accepted':True,'records':5,'tokens':1884,'operations':dict(Counter(x['operation'] for x in c['delta']['operations'])),'native_replay_tasks':32,'independent_sources':16,'actual_new_native_calls':32,'finish_reasons':dict(finishes),'native_usage':dict(usage),'parent_empty_metrics':metrics(first),'candidate_fit_metrics':metrics(after),'delta_F1_pp':{f:100*(metrics(after)[f]['f1']-metrics(first)[f]['f1']) for f in ['EC','EV']},'original_all_gates_recomputed_accepted':True,'all32_actual_payloads_schema_generation_and_real_guidance_checked':True,'no_solver_or_answer_repair':True,'composed_replay160files_including_original_calls':sorted(paths),'all3_taskwise_harms_preserved':harms,'teacher2_actual_parent_C1_and_all32_target_answer_score_exact':True,'teacher2_usage':response['invocation']['usage'],'teacher2_ops':dict(Counter(x['operation'] for x in response['value']['operations'])),'C2_proposal_not_yet_admitted_claim':True,'source_sha256':{str(p.relative_to(root)):sha(p) for p in source_files},'no_new_inference_teacher_tokenizer_or_TEST_call_from_audit':True}\nprint(json.dumps(result,ensure_ascii=False))\n"
