  "audit_recomputation_program": "import json,collections\nfrom pathlib import Path\nfrom legal_skill_guard.openexempt import upstream\nfrom legal_skill_guard.learning.experiment import now\nroot=Path.cwd();run=root/\"runs/legal_openexempt_closed_feedback_public_assets128_20261021_run02\"\ncfg=json.loads((root/\"configs/openexempt_closed_feedback_public_assets128_20261021_run02.json\").read_text())\np2=json.loads((run/\"publications/b2.json\").read_text());p3=json.loads((run/\"publications/b3.json\").read_text())\nc2=p3[\"training_decisions\"][1]\nparent=[x for x in p2[\"training_decisions\"] if x.get(\"accepted\")][-1][\"actual_replay\"]+json.loads((run/\"batches/b3_prequential_records.json\").read_text())[\"skills\"]\nroles={\"parent\":parent,\"proposed\":c2[\"proposed_replay\"],\"published\":c2[\"actual_replay\"]}\ne=upstream(\"evaluator\").Evaluator([]);norm=lambda v:v.strip().lower()\nallrows={};negative=[]\nfor name,rs in roles.items():\n rows=[]\n for r in rs:\n  if r[\"family\"]!=\"EC\":continue\n  t=json.loads((root/cfg[\"grading_directory\"]/f'{r[\"case_id\"]}.json').read_text())[\"targets\"][\"EC\"]\n  pred={norm(k):v for k,v in r[\"parsed\"][\"answer\"].items()};used=set();tp=fp=fn=negfp=0\n  for asset,laws in t.items():\n   key=e._find_matching_asset_description(norm(asset),list(pred))\n   vals={norm(c) for c in pred.get(key,[])} if key is not None and key not in used else set()\n   if key is not None:used.add(key)\n   gold={norm(c) for c in laws}\n   tp+=len(vals&gold);fp+=len(vals-gold);fn+=len(gold-vals)\n   if not gold:\n    negfp+=len(vals);negative.append({\"role\":name,\"case_id\":r[\"case_id\"],\"asset\":asset,\"target_laws\":[],\"predicted_laws\":sorted(vals),\"original_case_F1\":r[\"score\"][\"f1\"]})\n  fp+=sum(len(v) for k,v in pred.items() if k not in used)\n  p,re,f=e._precision_recall_f1_from_outcomes(tp,fp,fn)\n  rows.append({\"case_id\":r[\"case_id\"],\"tp\":tp,\"fp\":fp,\"fn\":fn,\"negative_asset_fp\":negfp,\"complete_EC_claim_F1_secondary_only\":f,\"original_EC_F1\":r[\"score\"][\"f1\"]})\n allrows[name]=rows\ndef summary(rows):\n return {\"sources\":len(rows),\"original_F1\":sum(r[\"original_EC_F1\"] for r in rows)/len(rows),\"complete_EC_F1_secondary\":sum(r[\"complete_EC_claim_F1_secondary_only\"] for r in rows)/len(rows),\"tp\":sum(r[\"tp\"] for r in rows),\"fp\":sum(r[\"fp\"] for r in rows),\"fn\":sum(r[\"fn\"] for r in rows),\"negative_asset_fp\":sum(r[\"negative_asset_fp\"] for r in rows)}\nout={\"at\":now(),\"classification\":\"Native EC macro blindspot on zero-target-citation assets: all48 seen parent/proposed/published outputs; secondary diagnostic, original scores unchanged\",\n\"all48_summary\":{n:summary(rs) for n,rs in allrows.items()},\"prior32_summary\":{n:summary([r for r in rs if r[\"case_id\"]<213]) for n,rs in allrows.items()},\"current16_summary\":{n:summary([r for r in rs if r[\"case_id\"]>=213]) for n,rs in allrows.items()},\n\"all48_per_source\":allrows,\"all_negative_target_assets\":negative,\n\"failure_boundary\":\"Case182 published adds33-1125(4)to pendant. Native caseF1 stays2/3; complete EC claimF1 falls1to0.8. Existing admission protects only originalEC and fullEV, so this legal falsepositive is not penalized.\",\n\"not_a_unique_new_problem_in_data\":\"Previous EV output-completeness audit already covered extras; EC counterpart had not been used for admission.\",\n\"no_new_model_or_teacher_calls\":0,\"no_B4_or_TEST_gold_loaded\":True}\nprint(json.dumps(out,ensure_ascii=False))"
