  "reproducer_program": "import json,collections,math\nfrom pathlib import Path\nfrom datetime import datetime,timezone\nfrom legal_skill_guard.openexempt import upstream,evaluate\nfrom legal_skill_guard.learning.legal_namespace import citation_namespace\nroot=Path.cwd();out=root/'runs/legal_openexempt_adaptive_legal_public_assets128_20261026_run01'\ncfg=json.loads((root/'configs/openexempt_adaptive_legal_public_assets128_20261026_run01.json').read_text())\nd=json.loads((out/'candidates/b8_candidate2.json').read_text());assert not d['accepted']\nbank=json.loads((out/'publications/b7.json').read_text())['bank'];proposed=d['proposed_bank']\na={s['id']:s for s in bank};b={s['id']:s for s in proposed}\nadded=set(b)-set(a);assert len(added)==1 and all(a[k]==b[k] for k in a)\nsid=next(iter(added));assert b[sid]['hypothesis_ids']==['EV'] and b[sid]['guidance']['jurisdiction']=='WISCONSIN'\nbefore={}\nfor batch in range(1,8):\n r=json.loads((out/f'batches/b{batch}_prequential_records.json').read_text())\n before.update({(r['case_id'],r['family']):r for r in r['skills']})\n for decision in json.loads((out/f'publications/b{batch}.json').read_text())['training_decisions']:\n  if decision['accepted']:before={(r['case_id'],r['family']):r for r in decision['actual_replay']}\nr=json.loads((out/'batches/b8_prequential_records.json').read_text())\nbefore.update({(r['case_id'],r['family']):r for r in r['skills']})\nafter={(r['case_id'],r['family']):r for r in d.get('proposed_replay',d['actual_replay'])}\nrows={(r['case_id'],r['family']):r for r in json.loads((root/cfg['input_packet']).read_text())['rows']}\nassert len(before)==len(after)==256\nchanged=[k for k in before if before[k]['raw_call_path']!=after[k]['raw_call_path']]\nassert len(changed)==27 and all(k[1]=='EV' and sid in after[k]['delivered_skill_ids'] for k in changed)\ne=upstream('evaluator').Evaluator([]);Claim=upstream('source.pydantic_response').Claim\ntransitions=[];cases=[];summary=collections.Counter();grade_checks=0\ndef view(answer,target):\n normalized={k.strip().lower():v for k,v in answer.items()};result={};used=set();extras=[]\n for asset,truth in target.items():\n  match=e._find_matching_asset_description(asset.strip().lower(),list(normalized))\n  supplied=normalized[match] if match is not None and match not in used else []\n  if match is not None:used.add(match)\n  tmap={Claim(**t).normalized_citation:Claim(**t) for t in truth}\n  all_truth={Claim(**t).normalized_citation:t for t in truth}\n  found=collections.defaultdict(list)\n  for v in supplied:\n   claim=Claim(**v);matched,rel=e._find_matching_claim(claim,list(tmap.values()))\n   correct=matched is not None and rel<.05\n   if correct:tmap.pop(matched.normalized_citation)\n   found[claim.normalized_citation].append({'value':v['claim_value'],'correct':correct,\n       'relative_error':rel,'extra_or_duplicate':matched is None})\n   if matched is None:extras.append({'asset':asset,'citation':v['citation'],'value':v['claim_value']})\n  for citation,t in all_truth.items():\n   values=found[citation];correct=any(v['correct'] for v in values)\n   result[asset,citation]={'status':'correct' if correct else 'wrong_value' if values else 'missing',\n      'values':values,'citation':t['citation'],'target':t['claim_value']}\n for asset,vv in normalized.items():\n  if asset not in used:\n   extras.extend({'asset':asset,'citation':v['citation'],'value':v['claim_value']} for v in vv)\n return result,extras\nfor key in sorted(changed):\n cid,family=key;row=rows[key]\n target=json.loads((root/cfg['grading_directory']/f'{cid}.json').read_text())['targets']['EV']\n rr=[before[key],after[key]]\n assert all(r['parse_error'] is None for r in rr)\n for r in rr:\n  fresh=evaluate(row,r['parsed']['answer'],target)\n  assert abs(fresh['f1']-r['score']['f1'])<1e-12 and abs(fresh['full_output_f1']-r['score']['full_output_f1'])<1e-12\n  grade_checks+=1\n old,oe=view(rr[0]['parsed']['answer'],target);new,ne=view(rr[1]['parsed']['answer'],target)\n delta=rr[1]['score']['f1']-rr[0]['score']['f1'];win='help' if delta>1e-12 else 'hurt' if delta< -1e-12 else 'tie'\n summary['cases_'+win]+=1\n case_changes=[]\n for k,t in old.items():\n  u=new[k];jurisdiction=citation_namespace(t['citation'])\n  if t['status']=='correct' and u['status']!='correct':kind='correct_to_'+u['status']\n  elif t['status']!='correct' and u['status']=='correct':kind=t['status']+'_to_correct'\n  else:continue\n  summary[kind]+=1;summary[jurisdiction+'__'+kind]+=1\n  event={'case_id':cid,'asset':k[0],'citation':t['citation'],'jurisdiction':jurisdiction,'target':t['target'],\n      'parent_status':t['status'],'candidate_status':u['status'],\n      'parent_values':[v['value'] for v in t['values']],'candidate_values':[v['value'] for v in u['values']],\n      'transition':kind}\n  transitions.append(event);case_changes.append(event)\n  if t['target']>0 and any(math.isclose(v['value']*2,t['target'],rel_tol=1e-9,abs_tol=1e-8) for v in u['values']):\n   summary['transition_candidate_exact_half_target']+=1\n cases.append({'case_id':cid,'current_batch':row['batch']==8,'parent_native_F1':rr[0]['score']['f1'],\n    'candidate_native_F1':rr[1]['score']['f1'],'difference_pp':100*delta,\n    'parent_full_output_F1':rr[0]['score']['full_output_f1'],'candidate_full_output_F1':rr[1]['score']['full_output_f1'],\n    'parent_extra_or_duplicate_claims':len(oe),'candidate_extra_or_duplicate_claims':len(ne),\n    'parent_raw':rr[0]['raw_call_path'],'candidate_raw':rr[1]['raw_call_path'],\n    'native_correct_to_incorrect_claims':sum(x['parent_status']=='correct' for x in case_changes),\n    'native_incorrect_to_correct_claims':sum(x['candidate_status']=='correct' for x in case_changes)})\ncurrent=[r for r in cases if r['current_batch']];prior=[r for r in cases if not r['current_batch']]\ndef cohort(rr):\n return {'sources':len(rr),'parent_native_F1_percent':100*sum(r['parent_native_F1'] for r in rr)/len(rr),\n   'candidate_native_F1_percent':100*sum(r['candidate_native_F1'] for r in rr)/len(rr)}\nout={'at':datetime.now(timezone.utc).isoformat(),'classification':'Complete rejected TRAIN C2 single WI EV card execution audit, not current TEST or a new model experiment',\n 'added_skill':b[sid],'all9_parent_records_byte_identical':True,'changed_EV_source_views':27,'unchanged_other_views':229,\n 'native_grade_replays_matched_original_records':grade_checks,'native_matching':'Unmodified original asset matcher, Claim.normalized_citation and original relative-error<0.05 rule (epsilon1), not exact-dollar equality',\n 'cohort_all27':cohort(cases),'cohort_current5':cohort(current),'cohort_prior22':cohort(prior),'counts':dict(summary),\n 'claim_transitions':transitions,'all27_case_outcomes':cases,\n 'not_a_unique_internal_model_causal_explanation_or_learning_population_estimate':True,\n 'same_frozen8B_requested_seed45_but_actual_serving_batch_history_may_differ':True,\n 'new_model_teacher_tokenizer_or_symbolic_solver_calls':0,'current_TEST_questions_predictions_targets_or_scores_read':False}\nprint(json.dumps(out,ensure_ascii=False))",
