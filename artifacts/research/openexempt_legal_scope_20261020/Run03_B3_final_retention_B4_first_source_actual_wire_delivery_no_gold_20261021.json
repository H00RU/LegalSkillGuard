  "recomputation_program": "import json,pathlib,datetime\nimport experiments.openexempt_online as e\nfrom legal_skill_guard.utils.hashing import canonical_json_sha256 as csha\nroot=pathlib.Path.cwd();r=root/\"runs/legal_openexempt_closed_feedback_public_assets128_20261021_run03\";read=lambda p:json.loads(p.read_text())\npub=read(r/\"publications/b3.json\");prior=read(r/\"publications/b2.json\");first=read(r/\"frozen_after_B1.json\")\nassert pub[\"bank\"]==prior[\"bank\"] and pub[\"bank_sha256\"]==pub[\"parent_bank_sha256\"]==prior[\"bank_sha256\"]\ncfg=read(root/\"configs/openexempt_closed_feedback_public_assets128_20261021_run03.json\")\nrows={(x[\"case_id\"],x[\"family\"]):x for x in read(root/cfg[\"input_packet\"])[\"rows\"] if x[\"case_id\"]==229}\nroles={\"empty\",\"frozen_initial\",\"empty_direct_numeric\",\"frozen_after_B1\",\"skills\"};records=[];requests={};members={str((r/\"publications/b3.json\").relative_to(root)),str((r/\"publications/b2.json\").relative_to(root)),str((r/\"frozen_after_B1.json\").relative_to(root))}\naps=list((r/\"native/b4_prequential\").glob(\"229_*.answer.json\"));assert len(aps)==10\nfor ap in aps:\n x=read(ap);bank=pub[\"bank\"] if x[\"arm\"]==\"skills\" else first[\"bank\"] if x[\"arm\"]==\"frozen_after_B1\" else []\n assert x[\"arm\"] in roles and x[\"bank_sha256\"]==csha(bank)\n row=rows[x[\"case_id\"],x[\"family\"]];messages,schema,supplied=e.actor_payload(row,bank,grounded=True,direct_numeric=True,asset_references=True)\n raw=read(root/x[\"raw_call_path\"]);req=raw[\"calls\"][0][\"request\"]\n assert req[\"messages\"]==messages and req[\"response_format\"][\"json_schema\"][\"schema\"]==schema and x[\"delivered_skill_ids\"]==[s[\"id\"] for s in supplied]\n assert x[\"native_program\"] is None and x[\"execution_receipt\"] is None\n ip=ap.with_name(ap.name[:-len(\".answer.json\")]+\".input.json\");members.update([str(ap.relative_to(root)),str(ip.relative_to(root)),x[\"raw_call_path\"]])\n assert (r/\"publications/b3.json\").stat().st_mtime_ns<=ip.stat().st_mtime_ns\n requests[x[\"family\"],x[\"arm\"]]=req\n records.append({\"case_id\":229,\"family\":x[\"family\"],\"arm\":x[\"arm\"],\"bank_sha256\":x[\"bank_sha256\"],\"delivered_skill_ids\":x[\"delivered_skill_ids\"],\"raw_call_path\":x[\"raw_call_path\"],\"finish_reason\":raw[\"response\"][\"finish_reason\"],\"parse_error\":x[\"parse_error\"]})\nfor family in (\"EC\",\"EV\"):\n reqs=[{k:v for k,v in requests[family,role].items() if k!=\"messages\"} for role in roles];assert all(csha(x)==csha(reqs[0]) for x in reqs)\nout={\"at\":datetime.datetime.now(datetime.timezone.utc).isoformat(),\"classification\":\"Actual B3 unique final unchanged parent delivered to fixed firstB4 source229, compared with exact ownB1 and strongempty request contracts; no B4 labels or scores read\",\"published_B3\":{\"at\":pub[\"at\"],\"records\":len(pub[\"bank\"]),\"bank_sha256\":pub[\"bank_sha256\"],\"same_as_true_B2_parent\":True,\"rejected_fc4_C1_bank_not_delivered_as_active\":True},\"own_B1_bank_sha256\":first[\"bank_sha256\"],\"all10_complete_actual_messages_schema_and_delivery_slots_verified\":records,\"per_task_all_generation_fields_except_messages_equal\":True,\"B3_published_before_B4_request_inputs\":True,\"future_or_TEST_targets_or_partial_scores_read\":False,\"new_native_teacher_or_TEST_calls\":0,\"evidence_paths\":sorted(members)}\nprint(json.dumps(out,ensure_ascii=False))\n"
