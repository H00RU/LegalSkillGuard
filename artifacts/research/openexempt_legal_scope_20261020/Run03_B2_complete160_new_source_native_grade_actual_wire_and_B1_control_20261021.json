  "audit_recomputation_program": "import json,pathlib,collections\nimport experiments.openexempt_online as e\nfrom legal_skill_guard.openexempt import evaluate,metrics\nfrom legal_skill_guard.learning.experiment import now\nfrom legal_skill_guard.utils.hashing import canonical_json_sha256 as csha\nroot=pathlib.Path.cwd();r=root/\"runs/legal_openexempt_closed_feedback_public_assets128_20261021_run03\";read=lambda p:json.loads(p.read_text())\npath=r/\"batches/b2_prequential_records.json\";summary=r/\"batches/b2_prequential.json\"\nif not path.exists() or not summary.exists():print(json.dumps({\"ready\":False,\"reason\":\"complete B2 first forecasts not both immutable\"}));raise SystemExit(0)\nrecords=read(path);saved=read(summary);cfg=read(root/\"configs/openexempt_closed_feedback_public_assets128_20261021_run03.json\")\npub=read(r/\"publications/b1.json\");frozen=read(r/\"frozen_after_B1.json\");assert pub[\"bank\"]==frozen[\"bank\"]\nroles={\"empty\",\"skills\",\"frozen_initial\",\"empty_direct_numeric\",\"frozen_after_B1\"};assert set(records)==roles\nkeys={(i,f) for i in range(197,213) for f in (\"EC\",\"EV\")}\nrows={(x[\"case_id\"],x[\"family\"]):x for x in read(root/cfg[\"input_packet\"])[\"rows\"] if (x[\"case_id\"],x[\"family\"]) in keys}\ntargets={i:read(root/cfg[\"grading_directory\"]/f\"{i}.json\")[\"targets\"] for i in range(197,213)}\nraws={};members={str(path.relative_to(root)),str(summary.relative_to(root)),str((r/\"publications/b1.json\").relative_to(root)),str((r/\"frozen_after_B1.json\").relative_to(root))}\nby={};saved_answers=[]\nfor role,rs in records.items():\n assert len(rs)==32 and {(x[\"case_id\"],x[\"family\"]) for x in rs}==keys\n bank=pub[\"bank\"] if role in (\"skills\",\"frozen_after_B1\") else [];by[role]={}\n for x in rs:\n  row=rows[x[\"case_id\"],x[\"family\"]];assert x[\"bank_sha256\"]==csha(bank)\n  answer=(x[\"parsed\"] or {}).get(\"answer\");assert csha(evaluate(row,answer,targets[x[\"case_id\"]][x[\"family\"]]))==csha(x[\"score\"])\n  messages,schema,supplied=e.actor_payload(row,bank,grounded=True,direct_numeric=True,asset_references=True)\n  raw=read(root/x[\"raw_call_path\"]);req=raw[\"calls\"][0][\"request\"]\n  assert req[\"messages\"]==messages and req[\"response_format\"][\"json_schema\"][\"schema\"]==schema\n  assert x[\"delivered_skill_ids\"]==[s[\"id\"] for s in supplied] and x[\"native_program\"] is None and x[\"execution_receipt\"] is None\n  ap=r/\"native\"/x[\"stage\"]/f'{x[\"case_id\"]}_{x[\"family\"]}_{x[\"arm\"]}.answer.json';assert ap.exists()\n  saved_answers.append(ap);members.update((str(ap.relative_to(root)),x[\"raw_call_path\"]));raws[x[\"raw_call_path\"]]=raw\n  by[role][x[\"case_id\"],x[\"family\"]]=x\n assert csha(metrics(rs))==csha(saved[role])\nfor key in keys:\n for a,b in [(\"empty\",\"frozen_initial\"),(\"empty\",\"empty_direct_numeric\"),(\"skills\",\"frozen_after_B1\")]:\n  assert by[a][key][\"parsed\"]==by[b][key][\"parsed\"] and by[a][key][\"score\"]==by[b][key][\"score\"] and by[a][key][\"raw_call_path\"]==by[b][key][\"raw_call_path\"]\nteacher=r/\"teacher/b2_candidate1/wire_request.json\"\nassert max(x.stat().st_mtime_ns for x in saved_answers)<=path.stat().st_mtime_ns\nif teacher.exists():assert path.stat().st_mtime_ns<=teacher.stat().st_mtime_ns\nout={\"at\":now(),\"classification\":\"Complete Run03 B2 first-encounter new-source32 tasks/all160 logical records; not training replay, finalTEST or continued-update advantage\",\n\"ready\":True,\"source_cases\":16,\"logical_records\":160,\"actual_native_original_and_complete_scores_and_wire_contracts_verified\":True,\n\"metrics\":{role:metrics(rs) for role,rs in records.items()},\"vs_strong_empty\":e.paired_effect(records[\"empty\"],records[\"skills\"]),\"vs_own_B1\":e.paired_effect(records[\"frozen_after_B1\"],records[\"skills\"]),\n\"own_B1_equality_expected_by_design_in_B2\":True,\"bank_sha256\":pub[\"bank_sha256\"],\"bank_records\":len(pub[\"bank\"]),\n\"native_raw_origins\":len(raws),\"HTTP_requests\":sum(len(x[\"calls\"]) for x in raws.values()),\"prompt_tokens\":sum(x[\"response\"][\"prompt_tokens\"] for x in raws.values()),\"completion_tokens\":sum(x[\"response\"][\"completion_tokens\"] for x in raws.values()),\n\"finish_reasons\":dict(collections.Counter(x[\"response\"][\"finish_reason\"] for x in raws.values())),\"parse_errors\":{role:sum(x[\"parse_error\"] is not None for x in rs) for role,rs in records.items()},\n\"new_model_teacher_or_TEST_calls_by_audit\":0,\"no_current_labels_read_by_this_audit_before_complete_records\":True,\"all160_answers_saved_before_teacher_request\":True if teacher.exists() else None,\n\"evidence_paths\":sorted(members)}\nprint(json.dumps(out,ensure_ascii=False))\n"
}
