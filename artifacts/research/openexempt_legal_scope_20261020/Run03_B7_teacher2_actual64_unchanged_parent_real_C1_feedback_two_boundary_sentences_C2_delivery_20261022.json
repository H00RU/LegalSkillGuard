  "audit_recomputation_program": "import json\nfrom pathlib import Path\nimport experiments.openexempt_online as e\nfrom legal_skill_guard.experiment.storage import RunStore\nfrom legal_skill_guard.utils.hashing import canonical_json_sha256 as csha\nroot=Path.cwd();r=root/\"runs/legal_openexempt_closed_feedback_public_assets128_20261021_run03\";base=root/\"artifacts/research/openexempt_legal_scope_20261020\";read=lambda p:json.loads(p.read_text())\ncfg=read(root/\"configs/openexempt_closed_feedback_public_assets128_20261021_run03.json\");rows={(x[\"case_id\"],x[\"family\"]):x for x in read(root/cfg[\"input_packet\"])[\"rows\"] if x[\"case_id\"]<=292}\npub=read(r/\"publications/b6.json\");previous=read(r/\"candidates/b6_candidate1.json\")[\"actual_replay\"];current=read(r/\"batches/b7_prequential_records.json\")[\"skills\"];parents={(x[\"case_id\"],x[\"family\"]):x for x in previous+current};assert len(parents)==224\nwirepath=r/\"teacher/b7_candidate2/wire_request.json\";responsepath=r/\"teacher/b7_candidate2/response.json\";wire=read(wirepath);body=json.loads(wire[\"user_prompt\"]);response=read(responsepath)\nassert csha(body[\"current_parent_library\"])==pub[\"bank_sha256\"]==\"8de3660c089acb139d048826658b74a698936683a3a37dc16a8f14679feca218\"\nselected=body[\"training_evidence_manifest\"][\"selected_source_ids\"];assert len(selected)==32 and set(range(277,293))<=set(selected)\nassert response[\"cache_hit\"] is False and response[\"invocation\"][\"returncode\"]==0 and not response[\"invocation\"][\"tool_events_detected\"]\nproposal=e.apply_differential_publication(pub[\"bank\"],response[\"value\"],e.FAMILIES,selected,guidance_schema=e.DIRECT_GUIDANCE);e.validate_scoped_bank(proposal)\nassert len(proposal)==6 and csha(proposal)==\"685f0aa86cd3baf7d6b8b119db24607e8a091105137528a82e0dad3df75eff82\"\nmembers={str(wirepath.relative_to(root)),str(responsepath.relative_to(root)),str((r/\"teacher/b7_candidate2/event_log.json\").relative_to(root)),str((r/\"publications/b6.json\").relative_to(root)),str((r/\"candidates/b6_candidate1.json\").relative_to(root)),str((r/\"batches/b7_prequential_records.json\").relative_to(root)),cfg[\"input_packet\"]}\nchecked=[]\nfor x in body[\"already_seen_training\"]:\n key=x[\"source_case_id\"],x[\"family\"];record=parents[key];row=rows[key];g=root/cfg[\"grading_directory\"]/f\"{key[0]}.json\"\n assert x[\"original_training_target\"]==read(g)[\"targets\"][key[1]] and x[\"facts\"]==row[\"components\"][\"facts\"] and x[\"public_solved_steps\"]==row[\"components\"][\"solved_steps\"]\n v=x[\"actual_parent_answer\"];assert v[\"score\"]==record[\"score\"] and v[\"executed_answer\"]==(record.get(\"parsed\") or {}).get(\"answer\") and v[\"parse_error\"]==record[\"parse_error\"] and v[\"native_program\"] is None and v[\"actual_operations\"] is None\n trace=v[\"source_model_emitted_evidence\"];raw=read(root/record[\"raw_call_path\"]);call=raw[\"calls\"][0];reason=call[\"response\"][\"choices\"][0][\"message\"].get(\"reasoning_content\") or \"\"\n assert trace[\"raw_call_path\"]==record[\"raw_call_path\"] and trace[\"canonical_call_sha256\"]==csha(call) and trace[\"reasoning\"][\"text\"]==reason[-1024:]\n members.update((str(g.relative_to(root)),record[\"raw_call_path\"]));checked.append(key)\nassert len(checked)==64 and set(checked)=={(i,f) for i in selected for f in e.FAMILIES}\nfeedback=[]\nfor d in body[\"rejected_candidate_feedback\"]:\n for ref in d[\"feedback_reference_replay\"]:\n  record=parents[ref[\"case_id\"],ref[\"family\"]]\n  assert ref[\"reference_is_this_request_parent\"] and ref[\"bank_sha256\"]==pub[\"bank_sha256\"] and ref[\"record_sha256\"]==csha(record) and ref[\"score\"]==record[\"score\"] and ref[\"raw_call_path\"]==record[\"raw_call_path\"]\n for witness in d[\"feedback_witness_replay\"]:\n  trace=witness[\"source_model_emitted_evidence\"];raw=read(root/trace[\"raw_call_path\"]);assert trace[\"canonical_call_sha256\"]==csha(raw[\"calls\"][0]);members.add(trace[\"raw_call_path\"])\n feedback.append({\"origin\":d[\"candidate_feedback_origin\"],\"accepted\":d[\"accepted\"],\"partially_committed\":d[\"partially_committed\"],\"actual_witnesses_delivered\":len(d[\"feedback_witness_replay\"]),\"actual_parent_references\":len(d[\"feedback_reference_replay\"]),\"stored_witnesses_before_bounded_history_filter\":d[\"bounded_feedback_witness_task_count\"],\"all_references_match_actual_B6_final_and_current_B7_parent\":True})\nco=e.legal_edit_coordinates(pub[\"bank\"],proposal,list(rows.values()));changed=[]\nfor c in co:\n f=c[\"task\"];ns=set(c[\"jurisdictions\"]);view=lambda bank:[x for x in e.task_view(bank,f) if x[\"guidance\"][\"jurisdiction\"] in ns]\n if view(pub[\"bank\"])!=view(proposal):\n  changed.append({**c,\"current_source_count\":sum(i>=277 for i in c[\"source_case_ids\"]),\"prior_source_count\":sum(i<277 for i in c[\"source_case_ids\"])})\nassert {x[\"id\"] for x in changed}=={\"EC:ILLINOIS\",\"EV:ILLINOIS\"}\ninputs=[]\nfor path in sorted((r/\"native/b7_candidate2_replay\").glob(\"*.input.json\")):\n try:x=read(path)\n except json.JSONDecodeError:continue\n i,f,arm=path.name.split(\".\")[0].split(\"_\",2);row=rows[int(i),f];msg,sch,sup=e.actor_payload(row,proposal,grounded=True,direct_numeric=True,asset_references=True)\n assert x[\"bank_sha256\"]==csha(proposal) and x[\"messages\"]==msg and x[\"schema\"]==sch and x[\"delivered_skill_ids\"]==[s[\"id\"] for s in sup]\n inputs.append({\"case_id\":int(i),\"family\":f,\"actual_proposal_delivery_verified\":True});members.add(str(path.relative_to(root)))\nmembers.update(str(p.relative_to(root)) for p in (r/\"teacher/b7_candidate2/cache\").rglob(\"*.json\"))\nout={\"at\":e.now(),\"classification\":\"Actual B7 teacher2 all16 current plus16 selected historical/64 TRAIN target-parent-trace rows; exact unchanged B6 final parent after actual C1 rejection and bounded real prior/C1 feedback; fresh service response; IL EC/EV only two appended real-property exclusions preserving all other parent bytes. No partial C2 scores, admitted skill or future gain.\",\"run_id\":r.name,\"actual_parent_bank_sha256\":pub[\"bank_sha256\"],\"verified_actual_target_parent_trace_rows\":64,\"training_evidence_manifest\":body[\"training_evidence_manifest\"],\"previous_publication_feedback_reference_checks\":feedback,\"actual_teacher_model\":response[\"model\"],\"fresh_not_cached_no_tools\":True,\"usage\":response[\"invocation\"][\"usage\"],\"elapsed_seconds\":response[\"invocation\"][\"elapsed_seconds\"],\"proposal_bank_sha256\":csha(proposal),\"proposed_records_not_final\":len(proposal),\"actual_operations\":response[\"value\"],\"actual_changed_coordinates\":changed,\"completed_planned_delivery_prefix_not_scores\":inputs,\"C2_complete_decision_exists_at_audit\":(r/\"candidates/b7_candidate2.json\").is_file(),\"new_native_teacher_TEST_calls_by_audit\":0,\"no_source_score_or_runtime_change\":True,\"evidence_paths\":sorted(members),\"audit_recomputation_program\":PROGRAM}\n\nc1=read(r/\"candidates/b7_candidate1.json\");assert not c1[\"accepted\"]\nmembers.add(str((r/\"candidates/b7_candidate1.json\").relative_to(root)))\nsuffixes={\"EC\":\" Subsection (b) is a personal-property exemption; do not apply it to any real-property interest.\",\"EV\":\" Subsection (b) applies only to personal property, not to any real-property interest.\"}\nsid=\"illinois-overlapping-wildcard-and-stated-limits\";old={s[\"id\"]:s for s in pub[\"bank\"]};new={s[\"id\"]:s for s in proposal};assert set(old)==set(new)\nfor skillid in old:\n if skillid!=sid:assert old[skillid]==new[skillid];continue\n oldskill=old[skillid];newskill=new[skillid]\n assert {k:v for k,v in oldskill.items() if k!=\"guidance\"}=={k:v for k,v in newskill.items() if k!=\"guidance\"}\n assert {k:v for k,v in oldskill[\"guidance\"].items() if k!=\"by_task\"}=={k:v for k,v in newskill[\"guidance\"].items() if k!=\"by_task\"}\n assert len(oldskill[\"guidance\"][\"by_task\"])==len(newskill[\"guidance\"][\"by_task\"])==2\n for o,n in zip(oldskill[\"guidance\"][\"by_task\"],newskill[\"guidance\"][\"by_task\"]):\n  f=o[\"tasks\"][0];assert n[\"avoid_when\"]==o[\"avoid_when\"]+suffixes[f]\n  assert {k:v for k,v in o.items() if k!=\"avoid_when\"}=={k:v for k,v in n.items() if k!=\"avoid_when\"}\nassert response[\"value\"][\"operations\"][0][\"target_ids\"]==[sid] and len(response[\"value\"][\"operations\"])==1\nassert any(x[\"candidate_feedback_origin\"][\"batch\"]==7 and x[\"candidate_feedback_origin\"][\"attempt\"]==1 for x in body[\"rejected_candidate_feedback\"])\nout[\"actual_change_exactly_two_appended_generic_boundary_sentences\"]=suffixes\nout[\"C1_bad_proposal_not_used_as_teacher2_parent\"]=True\nout[\"teacher2_rationale_is_a_model_hypothesis_not_proven_gain\"]=True\nout[\"evidence_paths\"]=sorted(members)\n\ndest=base/\"Run03_B7_teacher2_actual64_unchanged_parent_real_C1_feedback_two_boundary_sentences_C2_delivery_20261022.json\";RunStore.immutable_json(dest,out)\nprint(json.dumps({k:v for k,v in out.items() if k not in (\"audit_recomputation_program\",\"evidence_paths\",\"actual_operations\",\"completed_planned_delivery_prefix_not_scores\")},ensure_ascii=False))\n",
