lative_to(root)),str((r/\"publications/b7.json\").relative_to(root)),str((r/\"candidates/b7_candidate2.json\").relative_to(root)),str((r/\"batches/b8_prequential_records.json\").relative_to(root)),cfg[\"input_packet\"]}\nchecked=[]\nfor x in body[\"already_seen_training\"]:\n key=x[\"source_case_id\"],x[\"family\"];record=parents[key];row=rows[key];g=root/cfg[\"grading_directory\"]/f\"{key[0]}.json\"\n assert x[\"original_training_target\"]==read(g)[\"targets\"][key[1]] and x[\"facts\"]==row[\"components\"][\"facts\"] and x[\"public_solved_steps\"]==row[\"components\"][\"solved_steps\"]\n v=x[\"actual_parent_answer\"];assert v[\"score\"]==record[\"score\"] and v[\"executed_answer\"]==(record.get(\"parsed\") or {}).get(\"answer\") and v[\"parse_error\"]==record[\"parse_error\"] and v[\"native_program\"] is None and v[\"actual_operations\"] is None\n trace=v[\"source_model_emitted_evidence\"];raw=read(root/record[\"raw_call_path\"]);call=raw[\"calls\"][0];reason=call[\"response\"][\"choices\"][0][\"message\"].get(\"reasoning_content\") or \"\"\n assert trace[\"raw_call_path\"]==record[\"raw_call_path\"] and trace[\"canonical_call_sha256\"]==csha(call) and trace[\"reasoning\"][\"text\"]==reason[-1024:]\n members.update((str(g.relative_to(root)),record[\"raw_call_path\"]));checked.append(key)\nassert len(checked)==64 and set(checked)=={(i,f) for i in selected for f in e.FAMILIES}\nfeedback=[]\nfor d in body[\"rejected_candidate_feedback\"]:\n for ref in d[\"feedback_reference_replay\"]:\n  record=parents[ref[\"case_id\"],ref[\"family\"]]\n  assert ref[\"reference_is_this_request_parent\"] and ref[\"bank_sha256\"]==pub[\"bank_sha256\"] and ref[\"record_sha256\"]==csha(record) and ref[\"score\"]==record[\"score\"] and ref[\"raw_call_path\"]==record[\"raw_call_path\"]\n for witness in d[\"feedback_witness_replay\"]:\n  trace=witness[\"source_model_emitted_evidence\"];raw=read(root/trace[\"raw_call_path\"]);assert trace[\"canonical_call_sha256\"]==csha(raw[\"calls\"][0]);members.add(trace[\"raw_call_path\"])\n feedback.append({\"origin\":d[\"candidate_feedback_origin\"],\"accepted\":d[\"accepted\"],\"partially_committed\":d[\"partially_committed\"],\"actual_witnesses_delivered\":len(d[\"feedback_witness_replay\"]),\"actual_parent_references\":len(d[\"feedback_reference_replay\"]),\"stored_witnesses_before_bounded_history_filter\":d[\"bounded_feedback_witness_task_count\"],\"all_references_match_actual_B7_final_and_current_B8_parent\":True})\nco=e.legal_edit_coordinates(pub[\"bank\"],proposal,list(rows.values()));changed=[]\nfor c in co:\n f=c[\"task\"];ns=set(c[\"jurisdictions\"]);view=lambda bank:[x for x in e.task_view(bank,f) if x[\"guidance\"][\"jurisdiction\"] in ns]\n if view(pub[\"bank\"])!=view(proposal):\n  changed.append({**c,\"current_source_count\":sum(i>=293 for i in c[\"source_case_ids\"]),\"prior_source_count\":sum(i<293 for i in c[\"source_case_ids\"])})\ninputs=[]\nfor path in sorted((r/\"native/b8_candidate1_replay\").glob(\"*.input.json\")):\n try:x=read(path)\n except json.JSONDecodeError:continue\n i,f,arm=path.name.split(\".\")[0].split(\"_\",2);row=rows[int(i),f];msg,sch,sup=e.actor_payload(row,proposal,grounded=True,direct_numeric=True,asset_references=True)\n assert x[\"bank_sha256\"]==csha(proposal) and x[\"messages\"]==msg and x[\"schema\"]==sch and x[\"delivered_skill_ids\"]==[s[\"id\"] for s in sup]\n inputs.append({\"case_id\":int(i),\"family\":f,\"actual_proposal_delivery_verified\":True});members.add(str(path.relative_to(root)))\nmembers.update(str(p.relative_to(root)) for p in (r/\"teacher/b8_candidate1/cache\").rglob(\"*.json\"))\nout={\"at\":e.now(),\"classification\":\"Actual B8 teacher1 all16 current plus16 selected historical/64 TRAIN target-parent-trace rows; exact unique B7 final parent and bounded real B7 rejected/partial feedback, fresh service response and generic scoped proposal or NOOP. Delivery prefix is not admission or future gain.\",\"run_id\":r.name,\"proposal_is_noop_not_new_skill\":p