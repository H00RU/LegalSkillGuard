  "recomputation_shell_command": ".venv/bin/python -c 'import copy,json,collections; from pathlib import Path; from experiments.openexempt_online import acceptance,legal_scope_admission,actor_payload,paired_effect; from legal_skill_guard.learning.task_scoped_skills import legal_edit_coordinates,compose_legal_edits; from legal_skill_guard.openexempt import metrics; from legal_skill_guard.utils.hashing import canonical_json_sha256 as csha\nroot=Path(\"runs/legal_openexempt_anchored_execution_examples_TRAIN40_20261028_run01\")\nr=json.loads((root/\"paired_records.json\").read_text()); parent=json.loads(Path(\"runs/legal_openexempt_native_claim_feedback_public_assets128_20261027_run01/publications/b8.json\").read_text())[\"bank\"]; proposal=json.loads((root/\"candidate_fixed_before_new_answers.json\").read_text())[\"bank\"]; cfg=json.loads(Path(\"configs/openexempt_anchored_execution_examples_TRAIN40_20261028_run01.json\").read_text()); ids={v[\"case_id\"] for v in r[\"parent\"]}; rows=[v for v in json.loads(Path(cfg[\"input_packet\"]).read_text())[\"rows\"] if v[\"case_id\"] in ids]\ncoords=legal_edit_coordinates(parent,proposal,rows); decisions=legal_scope_admission(coords,r[\"parent\"],r[\"candidate\"],[],[]); accepted=[c[\"id\"] for c in coords if decisions[c[\"id\"]][\"accepted\"]]; composed=compose_legal_edits(parent,proposal,coords,accepted)\ncache={}\nfor rec in r[\"parent\"]+r[\"candidate\"]:\n p=Path(rec[\"raw_call_path\"]); w=json.loads(p.with_suffix(\".input.json\").read_text()); key=csha({\"messages\":w[\"messages\"],\"schema\":w[\"schema\"],\"generation\":cfg[\"generation\"]})\n if key in cache: assert cache[key][\"parsed\"]==rec[\"parsed\"] and cache[key][\"score\"]==rec[\"score\"]\n cache[key]=rec\nreplay=[]; proofs=[]\nfor row in rows:\n m,s,_=actor_payload(row,composed,direct_numeric=True,asset_references=True); key=csha({\"messages\":m,\"schema\":s,\"generation\":cfg[\"generation\"]}); assert key in cache; rec=copy.deepcopy(cache[key]); rec[\"bank_sha256\"]=csha(composed); replay.append(rec); proofs.append({\"case_id\":row[\"case_id\"],\"family\":row[\"family\"],\"fingerprint\":key,\"observed_raw\":rec[\"raw_call_path\"]})\ngate=acceptance(r[\"parent\"],replay,[],[])\nprint(json.dumps({\"scope\":\"Post-probe read-only fixed-parent/proposal replay of the existing legal_scope composition; original full-proposal adoption remains false; not a new trained policy or formal adoption\",\"proposal_full_gate\":acceptance(r[\"parent\"],r[\"candidate\"],[],[])[\"accepted\"],\"coordinates\":decisions,\"accepted_coordinates\":accepted,\"parent\":metrics(r[\"parent\"]),\"whole_proposal\":metrics(r[\"candidate\"]),\"existing_dependency_composition\":metrics(replay),\"composed_original_gate\":gate,\"composed_bank_sha256\":csha(composed),\"exact_wire_reuse_proofs\":proofs,\"composed_records_sha256\":csha(replay),\"new_native_teacher_grader_calls\":0,\"not_relabeling_original_completion\":True,\"family_paired_effects\":{f:paired_effect([v for v in r[\"parent\"] if v[\"family\"]==f],[v for v in replay if v[\"family\"]==f]) for f in (\"EC\",\"EV\")}},ensure_ascii=False))'"
