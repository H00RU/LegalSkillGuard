  "recomputation_program": "import copy,collections,json\nfrom pathlib import Path\nfrom experiments.openexempt_online import candidate_feedback,teacher_evidence_rows\nfrom legal_skill_guard.learning.experiment import read,sha,now\nfrom legal_skill_guard.utils.hashing import canonical_json_sha256 as csha\nfrom legal_skill_guard.experiment.storage import RunStore\nroot=Path.cwd();run=root/\"runs/legal_openexempt_closed_feedback_public_assets128_20261021_run03\"\nbase=root/\"artifacts/research/openexempt_legal_scope_20261020\"\ncfg=read(root/\"configs/openexempt_closed_feedback_public_assets128_20261021_run03.json\")\nrows=read(root/cfg[\"input_packet\"])[\"rows\"]\nlatest={};bank=[];teachers=[];omissions=[];packets=declared=supplied=0\nmembers={str((root/cfg[\"input_packet\"]).relative_to(root)),\"experiments/openexempt_online.py\",\n \"configs/openexempt_closed_feedback_public_assets128_20261021_run03.json\",\n \"configs/openexempt_closed_feedback_public_assets128_20261021_run03.frozen.json\"}\nkey=lambda r:(r[\"case_id\"],r[\"family\"])\nfor batch in range(1,9):\n pub_path=run/f\"publications/b{batch}.json\";pub=read(pub_path)\n first_path=run/f\"batches/b{batch}_prequential_records.json\";first=read(first_path)[\"skills\"]\n members.update(str(x.relative_to(root)) for x in (pub_path,first_path))\n current=[r for r in rows if r[\"batch\"]==batch];seen=[r for r in rows if r[\"batch\"]<=batch]\n batch_parent=copy.deepcopy(bank);obs={**latest,**{key(r):r for r in first}};rejected=[]\n assert csha(bank)==pub[\"parent_bank_sha256\"]\n if batch>1:\n  previous=read(run/f\"publications/b{batch-1}.json\")\n  for index,d in enumerate(previous[\"training_decisions\"],1):\n   f=candidate_feedback(d,obs,{\"batch\":batch-1,\"attempt\":index,\"publication_bank_sha256\":previous[\"bank_sha256\"]})\n   if f is not None:rejected.append(f)\n for attempt,d in enumerate(pub[\"training_decisions\"],1):\n  role=f\"b{batch}_candidate{attempt}\";wire_path=run/\"teacher\"/role/\"wire_request.json\";wire=read(wire_path)\n  body=json.loads(wire[\"user_prompt\"]);members.add(str(wire_path.relative_to(root)))\n  evidence,manifest=teacher_evidence_rows(current,seen,obs,rejected)\n  assert manifest==body[\"training_evidence_manifest\"],role\n  assert csha(body[\"current_parent_library\"])==csha(bank),role\n  assert len(rejected)==len(body[\"rejected_candidate_feedback\"]),role\n  selected=set(manifest[\"selected_source_ids\"]);teacher_missing=[]\n  for index,(full,actual) in enumerate(zip(rejected,body[\"rejected_candidate_feedback\"])):\n   full_rows=full[\"feedback_witness_replay\"];actual_rows=actual[\"feedback_witness_replay\"]\n   assert actual[\"candidate_feedback_origin\"]==full[\"candidate_feedback_origin\"]\n   assert actual[\"bounded_feedback_witness_task_count\"]==len(full_rows)==8\n   expected_kept=[r for r in full_rows if r[\"case_id\"] in selected]\n   assert [key(r) for r in actual_rows]==[key(r) for r in expected_kept]\n   packets+=1;declared+=len(full_rows);supplied+=len(actual_rows)\n   for record in full_rows:\n    if record[\"case_id\"] in selected:continue\n    before=obs[key(record)][\"score\"];after=record[\"score\"]\n    native=after[\"f1\"]-before[\"f1\"];complete=after[\"full_output_f1\"]-before[\"full_output_f1\"]\n    harmful=min(native,complete)<-1e-12\n    negative_delta=(after.get(\"negative_target_asset_predicted_claims\",0)+after.get(\"officially_unscored_predicted_claims\",0)\n       -before.get(\"negative_target_asset_predicted_claims\",0)-before.get(\"officially_unscored_predicted_claims\",0))\n    item={\"teacher\":role,\"feedback_packet\":index,\"origin\":full[\"candidate_feedback_origin\"],\n     \"case_id\":record[\"case_id\"],\"family\":record[\"family\"],\n     \"actual_parent_native_F1\":before[\"f1\"],\"proposed_native_F1\":after[\"f1\"],\"native_delta\":native,\n     \"actual_parent_full_output_F1\":before[\"full_output_f1\"],\"proposed_full_output_F1\":after[\"full_output_f1\"],\n     \"full_output_delta\":complete,\"native_or_complete_F1_regression\":harmful,\n     \"negative_or_unscored_claim_count_increase\":negative_delta,\n     \"parent_raw_origin\":obs[key(record)][\"raw_call_path\"],\"proposed_raw_origin\":record[\"raw_call_path\"],\n     \"omitted_due_to_historical_source_selection\":record[\"case_id\"] in manifest[\"omitted_historical_source_ids\"],\n     \"missing_from_case_evidence_and_filtered_feedback\":True}\n    assert item[\"omitted_due_to_historical_source_selection\"]\n    omissions.append(item);teacher_missing.append(item)\n  teachers.append({\"role\":role,\"historical_source_count\":len(manifest[\"selected_historical_source_ids\"]),\n   \"feedback_packets\":len(rejected),\"omitted_witness_occurrences\":len(teacher_missing),\n   \"omitted_genuinely_regressing_occurrences\":sum(x[\"native_or_complete_F1_regression\"] for x in teacher_missing)})\n  if d[\"accepted\"]:\n   bank=copy.deepcopy(d[\"candidate\"]);latest={key(r):r for r in d[\"actual_replay\"]};obs=dict(latest)\n   f=candidate_feedback(d,obs,{\"batch\":batch,\"attempt\":attempt,\"current_committed_bank_sha256\":csha(bank)})\n  else:\n   f=candidate_feedback(d,obs,{\"batch\":batch,\"attempt\":attempt,\"current_committed_bank_sha256\":csha(bank)})\n  if f is not None:rejected.append(f)\n if bank==batch_parent:latest=obs\n assert csha(bank)==pub[\"bank_sha256\"]\nassert len(teachers)==15 and declared-supplied==len(omissions)\nout={\"at\":now(),\"classification\":\"Replay actual15 teacher packets and all8 published parent states: bounded rejected-candidate witnesses are selected first then silently filtered by source communication subset; not causal performance proof\",\n \"teacher_requests\":len(teachers),\"feedback_packets\":packets,\"declared_witness_occurrences\":declared,\n \"actually_serialized_witness_occurrences\":supplied,\"omitted_witness_occurrences\":len(omissions),\n \"omitted_unique_task_keys\":len({(x[\"case_id\"],x[\"family\"]) for x in omissions}),\n \"teacher_requests_with_omissions\":sum(bool(x[\"omitted_witness_occurrences\"]) for x in teachers),\n \"omitted_genuinely_F1_regressing_occurrences\":sum(x[\"native_or_complete_F1_regression\"] for x in omissions),\n \"omitted_genuinely_regressing_unique_task_keys\":len({(x[\"case_id\"],x[\"family\"]) for x in omissions if x[\"native_or_complete_F1_regression\"]}),\n \"actual_parent_states_feedback_order_and_evidence_selection_reconstructed\":True,\n \"teachers\":teachers,\"actual_omitted_witnesses\":omissions,\n \"original_full_replay_and_gate_still_saw_all_seen_sources\":True,\n \"current_first8_trajectory_not_invalidated_by_this_training_communication_defect\":True,\n \"not_all_performance_root_cause_or_proof_of_any_repair_gain\":True,\n \"structural_fix_target\":\"Never drop already-selected bounded counterexamples in a later source filter; give all their facts, original TRAIN targets, actual parent/proposed outputs and correct reference. Compact duplicate controls rather than increasing teacher context or changing inference/gates.\",\n \"no_model_teacher_tokenizer_or_TEST_calls\":True,\n \"evidence_sha256\":{n:sha(root/n) for n in sorted(members)},\n \"recomputation_program\":PROGRAM}\ndest=base/\"Run03_actual15_teacher232_witness_delivery_source_filter_loss_and_true_harm_reconstruction_NOT_causal_20261023.json\"\nRunStore.immutable_json(dest,out)\nprint(json.dumps({\"report\":str(dest.relative_to(root)),\"teachers\":len(teachers),\"packets\":packets,\n \"declared_actual_omitted\":[declared,supplied,len(omissions)],\n \"affected_teacher_requests\":out[\"teacher_requests_with_omissions\"],\n \"omitted_unique_task_keys\":out[\"omitted_unique_task_keys\"],\n \"genuinely_harmful_occurrences\":out[\"omitted_genuinely_F1_regressing_occurrences\"],\n \"genuinely_harmful_unique_tasks\":out[\"omitted_genuinely_regressing_unique_task_keys\"],\n \"per_teacher\":teachers,\"not_causal\":True},ensure_ascii=False))\n"
