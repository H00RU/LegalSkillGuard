  "audit_recomputation_program": "import json,collections,difflib\nfrom pathlib import Path\nimport experiments.openexempt_online as e\nfrom legal_skill_guard.learning.experiment import now\nfrom legal_skill_guard.utils.hashing import canonical_json_sha256 as csha\nroot=Path.cwd();run=root/\"runs/legal_openexempt_closed_feedback_public_assets128_20261021_run02\"\ncfg=json.loads((root/\"configs/openexempt_closed_feedback_public_assets128_20261021_run02.json\").read_text())\nrows=[r for r in json.loads((root/cfg[\"input_packet\"]).read_text())[\"rows\"] if r[\"case_id\"]<=228]\nassert len(rows)==96\np2=json.loads((run/\"publications/b2.json\").read_text());parent=p2[\"bank\"]\nold=[d for d in p2[\"training_decisions\"] if d.get(\"accepted\")][-1][\"actual_replay\"]\ncurrent=json.loads((run/\"batches/b3_prequential_records.json\").read_text())\nobs={(r[\"case_id\"],r[\"family\"]):r for r in old+current[\"skills\"]}\nempty={};frozen={}\nfor b in (1,2,3):\n ds=json.loads((run/f\"batches/b{b}_prequential_records.json\").read_text())\n empty.update({(r[\"case_id\"],r[\"family\"]):r for r in ds[\"empty\"]})\n frozen.update({(r[\"case_id\"],r[\"family\"]):r for r in ds[\"frozen_initial\"]})\nw=json.loads((run/\"teacher/b3_candidate1/wire_request.json\").read_text());body=json.loads(w[\"user_prompt\"])\nresponse=json.loads((run/\"teacher/b3_candidate1/response.json\").read_text())\nselected=set(body[\"training_evidence_manifest\"][\"selected_source_ids\"])\nassert selected==set(body[\"current_source_case_ids\"])|set(body[\"training_evidence_manifest\"][\"selected_historical_source_ids\"])\nassert len(selected)==32 and set(body[\"current_source_case_ids\"])==set(range(213,229))\nassert csha(body[\"current_parent_library\"])==p2[\"bank_sha256\"]==body[\"candidate_feedback_contract\"][\"current_attempt_parent_bank_sha256\"]\nevidence=body[\"already_seen_training\"]\nassert len(evidence)==64 and {(r[\"source_case_id\"],r[\"family\"]) for r in evidence}=={(i,f) for i in selected for f in (\"EC\",\"EV\")}\nchecks=[];paths=set()\nfor r in evidence:\n i,f=r[\"source_case_id\"],r[\"family\"];key=i,f\n grading=root/cfg[\"grading_directory\"]/f\"{i}.json\";target=json.loads(grading.read_text())[\"targets\"][f]\n assert r[\"original_training_target\"]==target\n for role,record in ((\"actual_same_case_empty_answer\",empty[key]),(\"actual_same_case_frozen_initial_answer\",frozen[key]),(\"actual_parent_answer\",obs[key])):\n  v=r[role]\n  assert csha(v[\"score\"])==csha(record[\"score\"])\n  assert v[\"executed_answer\"]==(record.get(\"parsed\") or {}).get(\"answer\")\n  assert v[\"parse_error\"]==record[\"parse_error\"]\n raw=obs[key][\"raw_call_path\"];call=json.loads((root/raw).read_text())[\"calls\"][0]\n em=r[\"actual_parent_answer\"][\"source_model_emitted_evidence\"]\n assert em[\"raw_call_path\"]==raw and em[\"canonical_call_sha256\"]==csha(call)\n assert em[\"finish_reason\"]==call[\"response\"][\"choices\"][0][\"finish_reason\"]\n assert em[\"reasoning\"][\"text\"]==(call[\"response\"][\"choices\"][0][\"message\"].get(\"reasoning_content\") or \"\")[-1024:]\n paths.update((raw,str(grading.relative_to(root))))\n checks.append({\"case_id\":i,\"family\":f,\"label_empty_frozen_parent_raw_verified\":True})\nrefs=[]\nfor fb in body[\"rejected_candidate_feedback\"]:\n for r in fb.get(\"feedback_reference_replay\",[]):\n  record=obs[r[\"case_id\"],r[\"family\"]]\n  assert r[\"record_sha256\"]==csha(record) and r[\"raw_call_path\"]==record[\"raw_call_path\"]\n  assert r[\"bank_sha256\"]==record[\"bank_sha256\"] and r[\"score\"]==record[\"score\"]\n  refs.append({\"case_id\":r[\"case_id\"],\"family\":r[\"family\"],\"actual_refreshed_parent_verified\":True})\nproposal=e.apply_differential_publication(parent,response[\"value\"],e.FAMILIES,selected,guidance_schema=e.DIRECT_GUIDANCE)\nchanges=[];identical=collections.Counter()\nfor row in rows:\n a=e.actor_payload(row,parent,grounded=True,direct_numeric=True,asset_references=True)\n b=e.actor_payload(row,proposal,grounded=True,direct_numeric=True,asset_references=True)\n if csha(a[:2])==csha(b[:2]):identical[row[\"family\"]]+=1\n else:changes.append({\"case_id\":row[\"case_id\"],\"family\":row[\"family\"]})\nassert all(r[\"family\"]==\"EC\" for r in changes) and identical[\"EV\"]==48\nopcounts=collections.Counter(o[\"operation\"] for o in response[\"value\"][\"operations\"])\ndelta=[]\nfor op in response[\"value\"][\"operations\"]:\n for sid in op[\"target_ids\"]:\n  a=next(r for r in parent if r[\"id\"]==sid)\n  b=next(r for r in proposal if r[\"id\"]==sid)\n  delta.extend(difflib.unified_diff(json.dumps(a,ensure_ascii=False,indent=2).splitlines(),json.dumps(b,ensure_ascii=False,indent=2).splitlines(),fromfile=\"actual_parent\",tofile=\"actual_proposal\",lineterm=\"\"))\nfor p in (\"wire_request.json\",\"response.json\",\"event_log.json\"):paths.add(str((run/\"teacher/b3_candidate1\"/p).relative_to(root)))\nout={\"at\":now(),\"classification\":\"Actual B3teacher1 all64selected labels/parents/rawtraces and16refreshedfeedback refs; candidate not yet admission\",\n\"teacher\":response[\"model\"],\"request_sha256\":response[\"request_sha256\"],\"parent_bank_sha256\":csha(parent),\"proposal_bank_sha256\":csha(proposal),\n\"training_evidence_manifest\":body[\"training_evidence_manifest\"],\"all64_actual_evidence_checks\":checks,\"all_actual_refreshed_references\":refs,\n\"operations\":response[\"value\"][\"operations\"],\"actual_operation_counts\":dict(opcounts),\"actual_proposal_record_count\":len(proposal),\"actual_text_diff\":delta,\n\"all96_seen_actor_wires_identical_counts\":dict(identical),\"all96_seen_changed_actor_wires\":changes,\n\"all48_EV_wires_unchanged_not_new_EV_learning\":True,\"legal_coordinates\":e.legal_edit_coordinates(parent,proposal,rows),\n\"native_input_tokens\":response[\"invocation\"][\"usage\"][\"input_tokens\"],\"native_output_tokens\":response[\"invocation\"][\"usage\"][\"output_tokens\"],\n\"reasoning_output_tokens_subset\":response[\"invocation\"][\"usage\"][\"reasoning_output_tokens\"],\"elapsed_seconds\":response[\"invocation\"][\"elapsed_seconds\"],\n\"cache_hit\":response[\"cache_hit\"],\"tool_events\":response[\"invocation\"][\"tool_events_detected\"],\n\"all_current_source_evidence_included_no_unseen229plus\":True,\"new_model_or_teacher_calls_by_audit\":0,\n\"evidence_paths\":sorted(paths)}\nprint(json.dumps(out,ensure_ascii=False))"
}
