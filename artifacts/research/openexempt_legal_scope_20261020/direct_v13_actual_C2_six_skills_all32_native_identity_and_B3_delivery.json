    {
      "id": "arizona_prescribed_assistive_equipment",
      "hypothesis_ids": [
        "EV"
      ],
      "guidance": {
        "by_task": [
          {
            "tasks": [
              "EV"
            ],
            "when": "Arizona law applies and the facts identify an item as medically or professionally prescribed assistive equipment for the debtor or a dependent.",
            "procedure": "Treat the item as a prescribed prosthetic or mobility aid under Ariz. Rev. Stat. § 33-1125(9) and claim its full value because the supplied provision states no dollar cap.",
            "avoid_when": "Do not classify prescribed assistive equipment as ordinary household furniture merely because it is used in the home; do not apply this rule to ordinary furniture lacking the prescription or assistive condition."
          }
        ],
        "operators": [],
        "jurisdiction": "ARIZONA"
      }
    },
    {
      "id": "federal_household_item_cap_and_jewelry_boundary",
      "hypothesis_ids": [
        "EV"
      ],
      "guidance": {
        "by_task": [
          {
            "tasks": [
              "EV"
            ],
            "when": "An asset is considered under 11 U.S.C. § 522(d)(3) or is jewelry considered under § 522(d)(4).",
            "procedure": "First require that a § 522(d)(3) asset be one of the listed household-use categories, then assign no more than the lesser of its value and the $700 per-item limit. Evaluate jewelry separately under § 522(d)(4), using the lesser of value and $1,875 for one debtor. For jointly owned jewelry in a joint case, apply § 522(m) to each spouse's one-half interest and add the claims, each capped at $1,875.",
            "avoid_when": "Do not use the $14,875 aggregate ceiling as the claim for one item, classify jewelry under § 522(d)(3), or double § 522(d)(3)'s $700 cap for a particular jointly owned item."
          }
        ],
        "operators": [],
        "jurisdiction": "FEDERAL"
      }
    },
    {
      "id": "federal_wildcard_independent_alternative",
      "hypothesis_ids": [
        "EC",
        "EV"
      ],
      "guidance": {
        "by_task": [
          {
            "tasks": [
              "EC"
            ],
            "when": "Federal exemptions are allowable and an estate asset is being evaluated.",
            "procedure": "Evaluate 11 U.S.C. § 522(d)(5) for every kind of property as a separate alternative, including property also covered by a category-specific federal exemption.",
            "avoid_when": "Do not treat a category-specific exemption as excluding the wildcard, and do not add it where the supplied allowable jurisdictions exclude federal exemptions."
          },
          {
            "tasks": [
              "EV"
            ],
            "when": "Federal exemptions are allowable and an estate asset is being evaluated.",
            "procedure": "For 11 U.S.C. § 522(d)(5), calculate the independent claim as the lesser of the asset value and $1,475 plus up to $13,950 of unused § 522(d)(1). When no residence consumes that amount, use a $15,425 ceiling for one debtor. In a joint case, apply § 522(m) separately to each spouse's equal interest and add the two claims, so the combined ceiling is $30,850.",
            "avoid_when": "Do not aggregate allocations across assets, displace other applicable alternatives, assume unused homestead capacity when the facts show it has been consumed, or apply the two-debtor ceiling to a single debtor."
          }
        ],
        "operators": [],
        "jurisdiction": "FEDERAL"
      }
    },
    {
      "id": "illinois_any_other_property_alternative",
      "hypothesis_ids": [
        "EC"
      ],
      "guidance": {
        "by_task": [
          {
            "tasks": [
              "EC"
            ],
            "when": "Illinois exemptions are allowable and the debtor owns personal property.",
            "procedure": "Evaluate 735 Ill. Comp. Stat. 5/12-1001(b) as an independent alternative for the property, including when a more specific Illinois exemption also applies.",
            "avoid_when": "Do not use the $4,000 ceiling as an eligibility test, omit subsection (b) because a specific exemption applies, or classify jewelry as necessary wearing apparel under subsection (a) without facts establishing that condition."
          }
        ],
        "operators": [],
        "jurisdiction": "ILLINOIS"
      }
    },
    {
      "id": "oregon_any_personal_property_alternative",
      "hypothesis_ids": [
        "EC",
        "EV"
      ],
      "guidance": {
        "by_task": [
          {
            "tasks": [
              "EC"
            ],
            "when": "Oregon law applies and the asset is personal property.",
            "procedure": "Include Or. Rev. Stat. § 18.345(1)(p) as an independent alternative even when the asset also fits a specific Oregon exemption.",
            "avoid_when": "Do not apply it to real property or treat its $400 limit as a condition that makes a more valuable item ineligible."
          },
          {
            "tasks": [
              "EV"
            ],
            "when": "Oregon law applies and the asset is personal property.",
            "procedure": "For the independent Or. Rev. Stat. § 18.345(1)(p) alternative, assign the lesser of the asset's value and $400.",
            "avoid_when": "Do not aggregate different assets or omit separately applicable Oregon exemptions."
          }
        ],
        "operators": [],
        "jurisdiction": "OREGON"
      }
    },
    {
      "id": "pennsylvania_general_monetary_alternative",
