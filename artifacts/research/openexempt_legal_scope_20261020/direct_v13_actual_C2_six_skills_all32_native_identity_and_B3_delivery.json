          {
            "tasks": [
              "EC"
            ],
            "when": "Pennsylvania law applies to property of the judgment debtor.",
            "procedure": "Evaluate 42 Pa. Cons. Stat. § 8123 as an independent alternative for property of any category and include it alongside any specific Pennsylvania or federal exemption.",
            "avoid_when": "Do not restrict § 8123 to cash, and do not use its $300 limit as an eligibility test for property worth more than $300."
          },
          {
            "tasks": [
              "EV"
            ],
            "when": "Pennsylvania law applies to property of the judgment debtor.",
            "procedure": "For the independent 42 Pa. Cons. Stat. § 8123 alternative, assign the lesser of the property's value and $300.",
            "avoid_when": "Do not aggregate assets, replace a specific exemption, or exclude tangible property merely because the statute is titled a monetary exemption."
          }
        ],
        "operators": [],
        "jurisdiction": "PENNSYLVANIA"
      }
    }
