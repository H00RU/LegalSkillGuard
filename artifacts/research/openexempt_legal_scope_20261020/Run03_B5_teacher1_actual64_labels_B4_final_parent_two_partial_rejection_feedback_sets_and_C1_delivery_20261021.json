  "audit_recomputation_program": "import json,pathlib,collections\nfrom jsonschema import validate\nimport experiments.openexempt_online as e\nfrom legal_skill_guard.learning.publication import apply_differential_publication\nfrom legal_skill_guard.learning.task_scoped_skills import SCOPED_GUIDANCE_SCHEMA,validate_scoped_bank\nfrom legal_skill_guard.learning.legal_namespace import validate_scopes\nfrom legal_skill_guard.learning.experiment import now\nfrom legal_skill_guard.utils.hashing import canonical_json_sha256 as csha\nroot=pathlib.Path.cwd();r=root/\"runs/legal_openexempt_closed_feedback_public_assets128_20261021_run03\";read=lambda p:json.loads(p.read_text())\ncfg=read(root/\"configs/openexempt_closed_feedback_public_assets128_20261021_run03.json\")\ndecisions={(4,1):read(r/\"candidates/b4_candidate1.json\"),(4,2):read(r/\"candidates/b4_candidate2.json\")}\npub=read(r/\"publications/b4.json\");parent=pub[\"bank\"];parenthash=csha(parent);assert parenthash==pub[\"bank_sha256\"]\nparents={(x[\"case_id\"],x[\"family\"]):x for x in decisions[4,1][\"actual_replay\"]}\nparents.update({(x[\"case_id\"],x[\"family\"]):x for x in read(r/\"batches/b5_prequential_records.json\")[\"skills\"]})\nwire=r/\"teacher/b5_candidate1/wire_request.json\";response=r/\"teacher/b5_candidate1/response.json\";event=r/\"teacher/b5_candidate1/event_log.json\"\nw=read(wire);a=read(response);b=json.loads(w[\"user_prompt\"]);log=read(event)\nassert csha(w)==a[\"request_sha256\"] and csha(a[\"value\"])==a[\"response_sha256\"] and a[\"cache_hit\"] is False\nassert a[\"invocation\"][\"returncode\"]==0 and not a[\"invocation\"][\"tool_events_detected\"]\nassert csha({\"event_log\":log[\"event_log\"]})==a[\"invocation\"][\"event_log_sha256\"]\nvalidate(a[\"value\"],w[\"output_schema\"])\nassert b[\"current_parent_library\"]==parent and b[\"candidate_feedback_contract\"][\"current_attempt_parent_bank_sha256\"]==parenthash\nassert b[\"candidate_feedback_contract\"][\"attempt\"]==1 and b[\"candidate_feedback_contract\"][\"max_attempts\"]==2\nassert b[\"current_source_case_ids\"]==list(range(245,261))\nkeys={(i,f) for i in range(181,261) for f in (\"EC\",\"EV\")}\nrows={(x[\"case_id\"],x[\"family\"]):x for x in read(root/cfg[\"input_packet\"])[\"rows\"] if (x[\"case_id\"],x[\"family\"]) in keys}\nassert len(parents)==160 and len(b[\"already_seen_training\"])==64\nselected=b[\"training_evidence_manifest\"][\"selected_source_ids\"];expected_keys={(i,f) for i in selected for f in (\"EC\",\"EV\")}\nassert {(x[\"source_case_id\"],x[\"family\"]) for x in b[\"already_seen_training\"]}==expected_keys and expected_keys<=keys\nassert b[\"training_evidence_manifest\"][\"current_source_ids_all_included\"]==list(range(245,261))\nassert len(b[\"training_evidence_manifest\"][\"selected_historical_source_ids\"])==16 and set(b[\"training_evidence_manifest\"][\"selected_historical_source_ids\"])<=set(range(181,245))\nmembers={str(x.relative_to(root)) for x in [wire,response,event,r/\"candidates/b4_candidate1.json\",r/\"candidates/b4_candidate2.json\",r/\"publications/b4.json\",r/\"batches/b5_prequential_records.json\",r/\"batches/b5_prequential.json\"]}\nfor x in b[\"already_seen_training\"]:\n key=x[\"source_case_id\"],x[\"family\"];expected=parents[key];row=rows[key];v=x[\"actual_parent_answer\"]\n gp=root/cfg[\"grading_directory\"]/f\"{key[0]}.json\"\n assert x[\"original_training_target\"]==read(gp)[\"targets\"][key[1]] and x[\"facts\"]==row[\"components\"][\"facts\"]\n assert v[\"executed_answer\"]==expected[\"parsed\"][\"answer\"] and v[\"score\"]==expected[\"score\"]\n messages,schema,supplied=e.actor_payload(row,parent,grounded=True,direct_numeric=True,asset_references=True)\n raw=read(root/expected[\"raw_call_path\"]);call=raw[\"calls\"][0];req=call[\"request\"]\n assert expected[\"bank_sha256\"]==parenthash and req[\"messages\"]==messages and req[\"response_format\"][\"json_schema\"][\"schema\"]==schema\n assert expected[\"delivered_skill_ids\"]==[s[\"id\"] for s in supplied]\n trace=v[\"source_model_emitted_evidence\"];reasoning=call[\"response\"][\"choices\"][0][\"message\"].get(\"reasoning_content\") or \"\"\n assert trace[\"canonical_call_sha256\"]==csha(call) and trace[\"reasoning\"][\"text\"]==reasoning[-1024:] and trace[\"reasoning\"][\"canonical_text_sha256\"]==csha(reasoning)\n members.update((expected[\"raw_call_path\"],str(gp.relative_to(root))))\nfeedback_summaries=[]\nfor f in b[\"rejected_candidate_feedback\"]:\n origin=f[\"candidate_feedback_origin\"];prior=decisions[origin[\"batch\"],origin[\"attempt\"]]\n proposals={(x[\"case_id\"],x[\"family\"]):x for x in prior.get(\"proposed_replay\",prior[\"actual_replay\"])}\n witnesses=f[\"feedback_witness_replay\"];references=f[\"feedback_reference_replay\"]\n assert 0<len(witnesses)<=8 and len(witnesses)==len(references)\n for x in witnesses:\n  expected=proposals[x[\"case_id\"],x[\"family\"]]\n  assert x[\"score\"]==expected[\"score\"] and x[\"executed_answer\"]==expected[\"parsed\"][\"answer\"]\n for x in references:\n  expected=parents[x[\"case_id\"],x[\"family\"]]\n  assert x[\"reference_is_this_request_parent\"] and x[\"bank_sha256\"]==parenthash and x[\"record_sha256\"]==csha(expected) and x[\"score\"]==expected[\"score\"]\n feedback_summaries.append({\"origin\":origin,\"witness_count\":len(witnesses),\"all_references_match_real_current_B4_final_parent\":True,\"stored_origin_witness_count_before_history_filter\":f[\"bounded_feedback_witness_task_count\"],\"actual_delivered_reference_count\":len(references)})\nexpected_feedback_origins=[]\nfor index,decision in enumerate(pub[\"training_decisions\"],1):\n if e.candidate_feedback(decision,parents,{\"batch\":4,\"attempt\":index,\"publication_bank_sha256\":parenthash}) is not None:expected_feedback_origins.append((4,index))\nassert [(f[\"origin\"][\"batch\"],f[\"origin\"][\"attempt\"]) for f in feedback_summaries]==expected_feedback_origins\nassert b[\"candidate_feedback_contract\"][\"previous_publication_only_not_unbounded_history\"] is True and b[\"future_cases_and_labels_not_supplied\"] is True\ncandidate=apply_differential_publication(parent,a[\"value\"],e.FAMILIES,b[\"training_evidence_manifest\"][\"selected_source_ids\"],guidance_schema=SCOPED_GUIDANCE_SCHEMA)\nvalidate_scoped_bank(candidate);validate_scopes(candidate,rows[181,\"EC\"][\"components\"][\"statutes\"])\nassert all(not s[\"guidance\"][\"operators\"] for s in candidate)\nchecked=[]\nfor ap in sorted((r/\"native/b5_candidate1_replay\").glob(\"*.answer.json\")):\n x=read(ap);row=rows[x[\"case_id\"],x[\"family\"]]\n messages,schema,supplied=e.actor_payload(row,candidate,grounded=True,direct_numeric=True,asset_references=True)\n raw=read(root/x[\"raw_call_path\"]);req=raw[\"calls\"][0][\"request\"]\n assert x[\"bank_sha256\"]==csha(candidate) and req[\"messages\"]==messages and req[\"response_format\"][\"json_schema\"][\"schema\"]==schema\n assert x[\"delivered_skill_ids\"]==[s[\"id\"] for s in supplied] and x[\"native_program\"] is None and x[\"execution_receipt\"] is None\n checked.append({\"case_id\":x[\"case_id\"],\"family\":x[\"family\"],\"delivered_skill_ids\":x[\"delivered_skill_ids\"],\"finish_reason\":raw[\"response\"][\"finish_reason\"],\"parse_error\":x[\"parse_error\"]})\n members.update((str(ap.relative_to(root)),x[\"raw_call_path\"]))\nout={\"at\":now(),\"classification\":\"Actual B5 teacher1 all16 current plus16 selected historical sources/64 TRAIN tasks, actual B4 final parent and bounded actual previous-publication feedback sets, fresh response and completed delivery prefix; not an admitted gain\",\n\"current_parent_bank_sha256\":parenthash,\"current_parent_records\":len(parent),\"proposed_bank_sha256\":csha(candidate),\"proposed_records\":len(candidate),\n\"actual_parent_answers_targets_and_trace_origins_verified\":64,\"actual_previous_publication_partial_or_rejected_feedback_sets\":feedback_summaries,\"teacher_evidence_manifest\":b[\"training_evidence_manifest\"],\n\"fresh_response_and_no_tools_verified\":True,\"usage\":a[\"invocation\"][\"usage\"],\"elapsed_seconds\":a[\"invocation\"][\"elapsed_seconds\"],\n\"operation_counts\":dict(collections.Counter(x[\"operation\"] for x in a[\"value\"][\"operations\"])),\"operations\":a[\"value\"][\"operations\"],\n\"completed_C1_delivery_snapshots_at_audit\":checked,\"C1_complete_decision_exists_at_audit\":(r/\"candidates/b5_candidate1.json\").exists(),\n\"candidate_effect_not_yet_measured\":\"Actual nonempty proposal and delivery prefix are verified; only complete160-task seen-TRAIN admission and later first encounters can establish admitted effect.\",\n\"future_or_TEST_targets_read\":False,\"new_model_teacher_or_TEST_calls\":0,\"evidence_paths\":sorted(members)}\nprint(json.dumps(out,ensure_ascii=False))\n"
}
