  "operations": [
    {
      "operation": "UPDATE",
      "target_ids": [
        "illinois-overlapping-wildcard-and-stated-limits"
      ],
      "skill": {
        "id": "illinois-overlapping-wildcard-and-stated-limits",
        "hypothesis_ids": [
          "EC",
          "EV"
        ],
        "guidance": {
          "by_task": [
            {
              "tasks": [
                "EC"
              ],
              "when": "ILLINOIS is allowable and the property is held for personal rather than business use.",
              "procedure": "Evaluate 735 Ill. Comp. Stat. 5/12-1001(b) independently as the any-other-property alternative, including when apparel, a motor vehicle, or a prescribed health aid also has a specific exemption. Section (a) covers necessary wearing apparel, (c) covers a motor vehicle, and (e) covers professionally prescribed health aids. A value above a limit does not eliminate either applicable alternative. Determine category eligibility before considering value: a debtor-owned personal-use motor vehicle receives both subsections (b) and (c), with their ceilings affecting valuation only.",
              "avoid_when": "Do not use § 12-1001(d) for ordinary household property; it requires implements, professional books, or tools of the debtor's trade. Do not infer trade use merely because an object can be called a tool; require facts that it is used in the debtor's trade. Do not classify jewelry or a watch as necessary wearing apparel under subsection (a), and do not omit subsection (b) merely because a specific subsection applies."
            },
            {
              "tasks": [
                "EV"
              ],
              "when": "ILLINOIS is allowable and an eligible personal-use asset-exemption pair needs valuation.",
              "procedure": "Compute overlapping alternatives separately. For § 12-1001(b), use the lesser of value and $4,000 for one debtor, or $8,000 for jointly owned property of two debtors. For § 12-1001(c), use the lesser of value and $2,400; this vehicle limit is not doubled. Thus a jointly owned vehicle may have both an $8,000 subsection (b) alternative and a separate $2,400 subsection (c) alternative. Sections (a) and (e) have no stated dollar ceiling in the supplied text, so use the asset value.",
              "avoid_when": "Do not assign the $8,000 joint wildcard amount to subsection (c), replace the $2,400 vehicle limit with a wildcard limit, omit subsection (b) because a specific subsection applies, or apply these personal-property exemptions to business-use property."
            }
          ],
          "operators": [],
          "jurisdiction": "ILLINOIS"
        }
      },
      "source_case_ids": [
        195,
        204,
        255,
        260
      ],
      "rationale": "In sources 195 and 260, the parent treated the subsection (b) and (c) ceilings as eligibility tests and omitted both alternatives for above-limit personal-use vehicles; source 255 confirms that both remain applicable. Source 204 separately shows that an object's tool-like name does not establish the trade-use condition required by subsection (d). The update sharpens only those EC decision conditions and leaves the EV calculation guidance unchanged."
    }
  ],
