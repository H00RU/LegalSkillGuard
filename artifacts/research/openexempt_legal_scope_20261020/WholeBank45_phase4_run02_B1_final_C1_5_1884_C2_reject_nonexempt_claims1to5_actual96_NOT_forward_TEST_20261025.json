  "recomputation_program": "from pathlib import Path\nfrom datetime import datetime,timezone\nfrom collections import Counter\nimport json,hashlib\nfrom experiments.openexempt_online import actor_payload,acceptance\nfrom legal_skill_guard.openexempt import metrics\nfrom legal_skill_guard.utils.hashing import canonical_json_sha256 as csha\nroot=Path.cwd();run=root/'runs/legal_openexempt_whole_bank_public_assets128_phase4_20261025_run02'\nread=lambda p:json.loads(p.read_text());sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()\ncfgp=root/'configs/openexempt_whole_bank_public_assets128_phase4_20261025_run02.json';cfg=read(cfgp)\nc1=read(run/'candidates/b1_candidate1.json');c2=read(run/'candidates/b1_candidate2.json');pub=read(run/'publications/b1.json');snap=read(run/'frozen_after_B1.json')\nassert c1['accepted'] and not c2['accepted'] and c2['reason']=='whole_proposal_failed_original_full_gate'\nassert pub['bank']==c1['candidate']==snap['bank'] and csha(pub['bank'])==pub['bank_sha256']==snap['bank_sha256']\nassert pub['bank_sha256']!=csha(c2['candidate']) and snap['freeze_after_exactly_batch']==1\nassert [d['accepted'] for d in pub['training_decisions']]==[True,False]\nparent=c1['actual_replay'];after=c2['actual_replay'];derived=acceptance(parent,after,[],[])\nassert not derived['accepted'] and all(c2['proposed_whole_bank_acceptance'][k]==v for k,v in derived.items())\nassert all(derived[k] for k in ['current_family_nonregression','strict_current_improvement','current_full_output_nonregression']) and not derived['current_negative_asset_and_format_nonregression']\nrows={(r['case_id'],r['family']):r for r in read(root/cfg['input_packet'])['rows']};expected={(i,f) for i in range(181,197) for f in ['EC','EV']}\npaths=set();origins=set();usage=Counter();finishes=Counter();native_ids=set()\nassert len(after)==32 and {(r['case_id'],r['family']) for r in after}==expected\nfor a in after:\n p=run/f\"native/{a['stage']}/{a['case_id']}_{a['family']}_{a['arm']}.input.json\";d=read(p);bank=c2['proposed_bank']\n messages,schema,supplied=actor_payload(rows[a['case_id'],a['family']],bank,grounded=True,direct_numeric=True,asset_references=True)\n assert d['messages']==messages and d['schema']==schema and a['bank_sha256']==d['bank_sha256']==csha(bank)\n assert d['delivered_skill_ids']==a['delivered_skill_ids']==[s['id'] for s in supplied]\n raw=read(root/a['raw_call_path']);assert len(raw['calls'])==1 and not raw['transport_error'];q=raw['calls'][0]['request']\n assert q['messages']==messages and q['response_format']['json_schema']['schema']==schema\n assert all(q[k]==cfg['generation'][k] for k in ['model','seed','max_tokens','temperature','top_p','top_k'])\n assert a['native_program'] is None and a['execution_receipt'] is None\n assert json.loads(raw['calls'][0]['response']['choices'][0]['message']['content'])==a['public_label_submission']\n paths.update([str(p.relative_to(root)),str(p.with_name(p.name.replace('.input.json','.answer.json')).relative_to(root)),a['raw_call_path']]);origins.add(a['raw_call_path'])\nassert len(origins)==32 and len(paths)==96\nstages=[];allraw=[]\nfor stage in ['b1_prequential','b1_candidate1_replay','b1_candidate2_replay']:\n raw=[p for p in (run/'native'/stage).glob('*.json') if not p.name.endswith(('.input.json','.answer.json'))];assert len(raw)==32\n total=Counter();reasons=Counter()\n for p in raw:\n  r=read(p);assert not r['transport_error'] and len(r['calls'])==1;w=r['calls'][0]['response'];native_ids.add(w['id'])\n  total['input_tokens']+=w['usage']['prompt_tokens'];total['output_tokens']+=w['usage']['completion_tokens'];reasons[w['choices'][0]['finish_reason']]+=1\n assert reasons=={'stop':32};usage.update(total);finishes.update(reasons);allraw.extend(raw)\n stages.append({'stage':stage,'physical_generations':32,'usage':dict(total),'request_phase_wall_seconds':max(p.stat().st_mtime for p in raw)-min(p.with_suffix('.input.json').stat().st_mtime for p in raw)})\nassert len(native_ids)==96 and len(allraw)==96\nbefore={(a['case_id'],a['family']):a for a in parent}\npairs={}\nfor family in ['EC','EV']:\n deltas=[a['score']['f1']-before[a['case_id'],a['family']]['score']['f1'] for a in after if a['family']==family]\n pairs[family]={'sources':16,'native_F1_delta_pp':100*sum(deltas)/16,'help':sum(d>1e-12 for d in deltas),'hurt':sum(d<-1e-12 for d in deltas),'tie':sum(abs(d)<=1e-12 for d in deltas)}\ndef neg(s):return s['negative_target_asset_predicted_claims']+s.get('officially_unscored_predicted_claims',0)\nharms=[];bad_examples=[]\nfor a in after:\n b=before[a['case_id'],a['family']]\n if a['score']['f1']<b['score']['f1']-1e-12:harms.append({'source':a['case_id'],'family':a['family'],'before':b['score']['f1'],'after':a['score']['f1']})\n if neg(a['score'])>neg(b['score']):\n  t=read(root/cfg['grading_directory']/f\"{a['case_id']}.json\")['targets']\n  bad={asset:{'EC_target':t['EC'].get(asset),'absent_from_EV_target':asset not in t['EV'],'before_claims':b['parsed']['answer'].get(asset,[]),'after_claims':a['parsed']['answer'].get(asset,[])} for asset in a['score']['officially_unscored_predicted_assets']}\n  assert all(v['EC_target']==[] and v['absent_from_EV_target'] for v in bad.values())\n  bad_examples.append({'source':a['case_id'],'family':a['family'],'before_negative_unscored':neg(b['score']),'after_negative_unscored':neg(a['score']),'original_native_F1_before_after':[b['score']['f1'],a['score']['f1']],'confirmed_genuinely_nonexempt_by_released_EC_and_EV_targets':True,'assets':bad,'before_raw':b['raw_call_path'],'after_raw':a['raw_call_path']})\nassert [x['source'] for x in bad_examples]==[182,183]\nteachers=[];teacher_total=Counter()\nfor n in [1,2]:\n response=read(run/f'teacher/b1_candidate{n}/response.json');inv=response['invocation'];teacher_total.update(inv['usage'])\n teachers.append({'attempt':n,'elapsed_seconds':inv['elapsed_seconds'],'usage':inv['usage'],'model':response['model']})\nb2inputs=[]\nfor p in sorted((run/'native/b2_prequential').glob('*.input.json')):\n if not p.name.endswith(('_skills.input.json','_frozen_after_B1.input.json')):continue\n d=read(p);assert d['bank_sha256']==pub['bank_sha256']\n b2inputs.append({'path':str(p.relative_to(root)),'sha256':sha(p),'bank_sha256':d['bank_sha256']})\nassert b2inputs\nwall=datetime.fromisoformat(pub['at']).timestamp()-(run/'initialization.json').stat().st_mtime\nsource=[run/'publications/b1.json',run/'frozen_after_B1.json',run/'candidates/b1_candidate1.json',run/'candidates/b1_candidate2.json',run/'batches/b1_prequential.json',run/'batches/b1_prequential_records.json',cfgp,cfgp.with_suffix('.frozen.json')]\nfor n in [1,2]:\n source.extend(run/f'teacher/b1_candidate{n}'/x for x in ['wire_request.json','response.json','event_log.json'])\nresult={'at':datetime.now(timezone.utc).isoformat(),'classification':'Complete replacement Whole45 B1 final publication, rejected C2 genuine negative-asset overclaims, actual96call costs, fixed B1 snapshot and B2 published-bank delivery; NOT forward/test results','B1_final_bank':pub['bank_sha256'],'B1_records':5,'B1_tokens':1884,'publication_at':pub['at'],'B1_full_wall_seconds':wall,'C2_rejected_despite_both_native_and_full_mean_F1_improving':True,'C2_proposed_bank':csha(c2['proposed_bank']),'C2_proposed_records':len(c2['proposed_bank']),'C2_proposed_tokens':c2['proposed_tokens'],'C2_32_actual_payload_guidance_schema_generation_checked':True,'C2_original_full_gate_recomputed_exactly':True,'C2_failed_original_gate':'current_negative_asset_and_format_nonregression: EV false-claim count1to5; all formats valid','C1_fit':metrics(parent),'C2_fit':metrics(after),'C2_paired_contrasts':pairs,'all_native_taskwise_harms':harms,'two_verified_nonexempt_asset_examples_native_F1_still1':bad_examples,'C2_all96_raw_input_answer_paths':sorted(paths),'B1_physical_native_calls':96,'B1_native_finish_reasons':dict(finishes),'B1_native_usage':dict(usage),'B1_actual_generation_stages':stages,'B1_teachers':teachers,'B1_teacher_known_usage':dict(teacher_total),'reasoning_tokens_already_in_output_not_added_twice':True,'B1_snapshot_exact_publication_not_selected_using_B2':True,'B2_saved_actual_input_bank_proofs_no_partial_scores':b2inputs,'source_sha256':{str(p.relative_to(root)):sha(p) for p in source},'no_software_method_metric_teacher_or_model_changes':True,'no_new_generation_teacher_tokenizer_or_TEST_calls_from_audit':True,'no_TaskLocal_training_or_mixed_counterfactual_claim':True}\nprint(json.dumps(result,ensure_ascii=False))\n"
}
