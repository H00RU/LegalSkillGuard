          "jurisdiction": "ILLINOIS"
        }
      },
      "after": {
        "id": "illinois-other-personal-property-alternative",
        "hypothesis_ids": [
          "EV"
        ],
        "guidance": {
          "when": "Illinois exemptions are allowable and the asset is debtor-owned personal property evaluated under 735 Ill. Comp. Stat. 5/12-1001.",
          "procedure": "For every such asset, first append subsection (b) independently and report the lesser of whole value and $4,000 for one debtor or $8,000 for two equal-interest joint debtors. Then also append each qualifying specific alternative: subsection (a) for necessary wearing apparel at whole value; subsection (c) for a motor vehicle at the lesser of whole value and $2,400; subsection (d), when facts expressly show use in the debtor's trade or business, at the lesser of whole value and $1,500 for one debtor or $3,000 for two equal-interest joint debtors; and subsection (e) for a professionally prescribed health aid at whole value.",
          "avoid_when": "Do not apply this personal-property block to real property, replace subsection (b) with a specific subsection, omit subsection (b) from a vehicle, apparel item, health aid, or expressly business-used tool, double subsection (c)'s $2,400 asset-level result, or claim subsection (d) without an express trade-or-business-use fact.",
