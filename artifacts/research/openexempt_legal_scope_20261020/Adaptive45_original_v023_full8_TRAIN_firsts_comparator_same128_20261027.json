  "comparison_plan": "After newB8complete use exactsame source/batch pairs; keep firstforecasts distinct from postupdate replays and finalTEST. Old/new series is descriptive under documented learning/sourceepoch difference; newmatchedpolicies isolate the declared methodchoice under commoncurrent profile.",
  "reproducer_readonly_python": "import json,hashlib\nfrom pathlib import Path\nfrom datetime import datetime,timezone\nfrom experiments.openexempt_online import paired_effect,csha\nfrom legal_skill_guard.openexempt import metrics\nroot=Path.cwd();tp=root/'configs/openexempt_initial8_frozen_TEST_20261025_run01.json'\ntcfg=json.loads(tp.read_text());arm=next(a for a in tcfg['arms'] if a['role']=='evolved')\ncp=root/arm['source_config'];cfg=json.loads(cp.read_text());out=root/'runs'/cfg['run_id']\nnew=json.loads((root/'configs/openexempt_adaptive_legal_public_assets128_20261026_run01.json').read_text())\ncompletion=json.loads((out/'completion.json').read_text());assert completion['status']=='completed_bounded_mechanism_study' and len(completion['batch_summary'])==8\nassert hashlib.sha256(cp.read_bytes()).hexdigest()==arm['source_config_sha256']\nassert cfg['input_packet']==new['input_packet'] and cfg['generation']==new['generation']\npacket=json.loads((root/cfg['input_packet']).read_text())['rows'];assert len(packet)==256\nbatches=[];all_records={k:[] for k in ('empty','skills','frozen_after_B1')}\nfor b in range(1,9):\n records=json.loads((out/f'batches/b{b}_prequential_records.json').read_text());pre=json.loads((out/f'batches/b{b}_prequential.json').read_text())\n expected={(r['case_id'],r['family']) for r in packet if r['batch']==b}\n assert len(expected)==32\n for role in all_records:\n  assert len(records[role])==32 and {(r['case_id'],r['family']) for r in records[role]}==expected\n  recalculated=metrics(records[role])\n  for fam in ('EC','EV'):\n   for field in ('f1','full_output_f1','invalid_format','negative_or_unscored_asset_claims'):assert abs(recalculated[fam][field]-pre[role][fam][field])<1e-12\n  all_records[role].extend(records[role])\n effects={}\n for control in ('empty','frozen_after_B1'):\n  effects[control]={fam:paired_effect([r for r in records[control] if r['family']==fam],[r for r in records['skills'] if r['family']==fam]) for fam in ('EC','EV')}\n batches.append({'batch':b,'source_cases':16,'case_ids':sorted({k[0] for k in expected}),'main_EC_EV_percent':[100*pre['skills'][f]['f1'] for f in ('EC','EV')],'ownB1_EC_EV_percent':[100*pre['frozen_after_B1'][f]['f1'] for f in ('EC','EV')],'empty_EC_EV_percent':[100*pre['empty'][f]['f1'] for f in ('EC','EV')],'same_source_effects':effects,'prequential_main_bank_sha256':pre['parent_bank_sha256'],'actual_new_native_first_generations':pre['prequential_actual_new_native_calls'],'original_records_path':str((out/f'batches/b{b}_prequential_records.json').relative_to(root)),'original_records_sha256':hashlib.sha256((out/f'batches/b{b}_prequential_records.json').read_bytes()).hexdigest()})\nfor role,field in (('skills','prequential_skills'),('empty','prequential_empty'),('frozen_after_B1','prequential_frozen_after_B1')):\n score=metrics(all_records[role]);assert all(abs(score[f]['f1']-completion[field][f]['f1'])<1e-12 for f in ('EC','EV'))\nprint(json.dumps({'at':datetime.now(timezone.utc).isoformat(),'classification':'Preserved originalv023 main full8 TRAIN first forecasts only, not new-run result, after-update replay or TEST','old_source_config':arm['source_config'],'old_run_id':cfg['run_id'],'new_run_id':new['run_id'],'same_TRAIN_packet_and_order':True,'same_generation_settings':True,'original_learning_serial_vs_new_four_native_one_teacher_difference_retained':True,'old_phase_dispatch':cfg.get('phase_dispatch'),'new_phase_dispatch':new.get('phase_dispatch'),'both_ownB1_perbatch_controls_available':cfg.get('frozen_after_first_batch_control') and new.get('frozen_after_first_batch_control'),'all8_old_batches':batches,'original_full128_firstforecast_metrics':{role:metrics(v) for role,v in all_records.items()},'no_TEST_questions_targets_predictions_scores_read':True,'no_extra_model_teacher_tokenizer_native_grader_or_symbolic_solver_call':True,'comparison_plan':'After newB8complete use exactsame source/batch pairs; keep firstforecasts distinct from postupdate replays and finalTEST. Old/new series is descriptive under documented learning/sourceepoch difference; newmatchedpolicies isolate the declared methodchoice under commoncurrent profile.'},ensure_ascii=False))\n"
