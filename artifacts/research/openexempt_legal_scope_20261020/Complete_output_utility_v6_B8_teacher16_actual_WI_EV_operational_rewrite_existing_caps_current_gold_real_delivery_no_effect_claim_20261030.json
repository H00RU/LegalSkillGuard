  "actual_changed_EV": {
    "EC:wisconsin-consumer-goods": {
      "parent": {
        "id": "EC:wisconsin-consumer-goods",
        "hypothesis_ids": [
          "EV"
        ],
        "guidance": {
          "when": "When WISCONSIN is allowable and an asset is being valued.",
          "procedure": "Match § 815.18(3)(d) to listed personal, family, or household consumer goods, including firearms, with a whole-asset ceiling of $12,000 for one debtor or $24,000 for two equal joint debtors. Match § 815.18(3)(g) to a motor vehicle; when no used consumer-goods amount is supplied in this independent-pair task, its $4,000 vehicle amount plus unused (d) gives a $16,000 ceiling for one debtor or $32,000 for two equal joint debtors. Match § 815.20(1) only to an occupied homestead, capped at $75,000 for one debtor or $150,000 for two joint spouses. For every citation report the smaller of the whole asset value and that ceiling.",
          "avoid_when": "Do not put a motor vehicle under (3)(d). A firearm is consumer goods under (3)(d), not a depository account under (3)(k) or business property under (3)(b)(1) without the required account or business-use facts. Do not emit § 815.18(8), leave a half-interest as the result, or stop at one spouse's ceiling for jointly owned property where the statute permits both spouses' exemptions.",
          "operators": [],
          "jurisdiction": "WISCONSIN"
        }
      },
      "proposed": {
        "id": "EC:wisconsin-consumer-goods",
        "hypothesis_ids": [
          "EV"
        ],
        "guidance": {
          "when": "When WISCONSIN is allowable and an asset is being valued.",
          "procedure": "For listed nonvehicle consumer goods, including firearms, use § 815.18(3)(d), capped for the whole asset at $12,000 for one debtor or $24,000 for two equal joint debtors. For a motor vehicle, output only § 815.18(3)(g), not a separate (d) claim. Because this independent-pair task supplies no used consumer-goods amount, treat the (d) amount as unused: the single (g) claim has a $16,000 ceiling for one debtor or $32,000 for two equal joint debtors. Use § 815.20(1) only for an occupied homestead, capped at $75,000 for one debtor or $150,000 for two joint spouses. For each citation output the smaller of the whole asset value and its ceiling.",
          "avoid_when": "Do not put a motor vehicle under (3)(d) or split its combined vehicle protection into separate (3)(g) and (3)(d) claims. A firearm is consumer goods under (3)(d), not a depository account under (3)(k) or business property under (3)(b)(1) without the required facts. Do not emit § 815.18(8), leave a half-interest as the result, or stop at one spouse's ceiling for jointly owned property where both spouses' exemptions apply.",
          "operators": [],
          "jurisdiction": "WISCONSIN"
        }
      }
    }
  },
