  "recomputation_program": "import collections, hashlib, json\nfrom pathlib import Path\nfrom datetime import datetime, timezone\nfrom experiments.openexempt_online import legal_scope_admission\nfrom legal_skill_guard.learning.task_scoped_skills import task_view,legal_edit_coordinates\nfrom legal_skill_guard.openexempt import metrics\nfrom legal_skill_guard.experiment.storage import RunStore\nfrom legal_skill_guard.utils.hashing import canonical_json_sha256 as csha\nroot=Path.cwd();base=root/\"artifacts/research/openexempt_legal_scope_20261020\"\nrun=root/\"runs/legal_openexempt_closed_feedback_public_assets128_20261021_run03\"\ndef rd(p):return json.loads(p.read_text())\ncfg=rd(root/\"configs/openexempt_closed_feedback_public_assets128_20261021_run03.json\")\nrows=rd(root/cfg[\"input_packet\"])[\"rows\"]\nbank=[];latest={};changed=[];teacher_attempts=0;actual_postB1_EC_edit_attempts=0;NOOPs=0;all_sources=set()\ndef scoped(bank):\n result={}\n for record in task_view(bank,\"EC\"):result.setdefault(record[\"guidance\"][\"jurisdiction\"],[]).append(record)\n return result\ndef family_metrics(records):\n if not records:return {}\n score=metrics(records)[\"EC\"]\n return {k:score[k] for k in (\"f1\",\"full_output_f1\",\"negative_or_unscored_asset_claims\",\"invalid_format\")}\nfor batch in range(1,9):\n pubpath=run/\"publications\"/f\"b{batch}.json\";pub=rd(pubpath)\n all_sources.add(str(pubpath.relative_to(root)))\n assert pub[\"parent_bank_sha256\"]==csha(bank)\n current=[r for r in rows if r[\"batch\"]==batch];seen=[r for r in rows if r[\"batch\"]<=batch]\n current_ids={r[\"case_id\"] for r in current}\n recordpath=run/\"batches\"/f\"b{batch}_prequential_records.json\"\n first=rd(recordpath);all_sources.add(str(recordpath.relative_to(root)))\n current_parent=first[\"skills\"]\n observations={**latest,**{(r[\"case_id\"],r[\"family\"]):r for r in current_parent}}\n for attempt,d in enumerate(pub[\"training_decisions\"],1):\n  teacher_attempts+=1\n  if d.get(\"explicit_noop\"):\n   NOOPs+=1;continue\n  assert d[\"attempt_parent_bank_sha256\"]==csha(bank)\n  proposed=d[\"proposed_bank\"]\n  parent_current=[observations[(r[\"case_id\"],r[\"family\"])] for r in current]\n  prior_rows=[r for r in seen if r[\"case_id\"] not in current_ids]\n  parent_prior=[observations[(r[\"case_id\"],r[\"family\"])] for r in prior_rows]\n  proposed_replay=d.get(\"proposed_replay\",d[\"actual_replay\"])\n  prop_current=[r for r in proposed_replay if r[\"case_id\"] in current_ids]\n  prop_prior=[r for r in proposed_replay if r[\"case_id\"] not in current_ids]\n  coordinates=legal_edit_coordinates(bank,proposed,seen)\n  assert csha(coordinates)==csha(d[\"legal_edit_coordinates\"])\n  recomputed=legal_scope_admission(coordinates,parent_current,prop_current,parent_prior,prop_prior)\n  assert recomputed==d[\"legal_scope_admission\"]\n  old,new=scoped(bank),scoped(proposed)\n  changed_jurisdictions={s for s in set(old)|set(new) if csha(old.get(s,[]))!=csha(new.get(s,[]))}\n  if batch>1 and changed_jurisdictions:\n   actual_postB1_EC_edit_attempts+=1\n   for coordinate in coordinates:\n    if coordinate[\"task\"]!=\"EC\" or not changed_jurisdictions&set(coordinate[\"jurisdictions\"]):continue\n    gate=recomputed[coordinate[\"id\"]];ids=set(coordinate[\"source_case_ids\"])\n    groups=[[r for r in cohort if r[\"family\"]==\"EC\" and r[\"case_id\"] in ids] for cohort in (parent_current,prop_current,parent_prior,prop_prior)]\n    assert groups[0]\n    failed=[k for k,v in gate.items() if isinstance(v,bool) and not v and k!=\"accepted\"]\n    if gate[\"accepted\"]:kind=\"accepted_actual_EC_component\"\n    elif not gate[\"current_nonregression\"] or not gate[\"prior_nonregression\"]:kind=\"rejected_native_F1_loss\"\n    elif not all(gate[k] for k in (\"current_full_output_nonregression\",\"prior_full_output_nonregression\",\"current_negative_asset_and_format_nonregression\",\"prior_negative_asset_and_format_nonregression\")):kind=\"rejected_complete_output_or_negative_asset_loss_without_native_F1_loss\"\n    else:kind=\"rejected_no_strict_current_improvement_or_other\"\n    changed.append({\"batch\":batch,\"attempt\":attempt,\"coordinate\":coordinate[\"id\"],\"changed_EC_jurisdictions_within_coordinate\":sorted(changed_jurisdictions&set(coordinate[\"jurisdictions\"])),\"classification\":kind,\"recomputed_gate\":gate,\"all_failed_flags\":failed,\"current_parent\":family_metrics(groups[0]),\"current_proposal\":family_metrics(groups[1]),\"past_parent\":family_metrics(groups[2]),\"past_proposal\":family_metrics(groups[3]),\"actual_final_component_accepted\":coordinate[\"id\"] in d[\"accepted_legal_coordinates\"],\"whole_attempt_accepted\":d[\"accepted\"]})\n  if d[\"accepted\"]:\n   bank=d[\"candidate\"]\n   observations={(r[\"case_id\"],r[\"family\"]):r for r in d[\"actual_replay\"]}\n latest=observations\n assert csha(bank)==pub[\"bank_sha256\"]\nassert teacher_attempts==15 and NOOPs==1\ncounts=dict(collections.Counter(r[\"classification\"] for r in changed))\nassert len(changed)==11 and actual_postB1_EC_edit_attempts==8\nassert counts=={\"rejected_native_F1_loss\":5,\"rejected_complete_output_or_negative_asset_loss_without_native_F1_loss\":4,\"accepted_actual_EC_component\":2},counts\nassert all(r[\"actual_final_component_accepted\"]==r[\"recomputed_gate\"][\"accepted\"] for r in changed)\nout={\"at\":datetime.now(timezone.utc).isoformat(),\"classification\":\"Complete TRAIN post-B1 EC publication bottleneck reconstructed from actual changing parent observations, all15 teacher decisions and8 final publications. Eleven edited connected scope components across8 proposals; counts are repeated training attempts, not independent cases. No new model calls and no TEST.\",\n\"all15_actual_parents_and_all_scope_gate_flags_recomputed\":True,\"post_B1_EC_edit_attempts\":actual_postB1_EC_edit_attempts,\"post_B1_changed_EC_connected_component_attempts\":len(changed),\"gate_outcome_counts\":counts,\"all11_changed_EC_components\":changed,\n\"zero_new_actor_teacher_tokenizer_or_TEST_calls\":True,\"no_gate_or_endpoint_modified\":True,\n\"interpretation\":\"Only Oregon EC at B2C2 and Illinois EC at B7C2 entered the post-B1 bank. EC updates were proposed more broadly but9 changed-component attempts failed real training preservation checks:5 had native F1 loss and4 had complete-output or negative-asset loss despite native nonregression. This is not evidence every rejected candidate harms future cases, nor that loosening gates would improve independent learning. Preserve declared whole_bank/first_commit ablations and original full-stream denominators.\",\n\"original_artifact_sha256\":{n:hashlib.sha256((root/n).read_bytes()).hexdigest() for n in sorted(all_sources)},\"recomputation_program\":PROGRAM}\ndest=base/\"Run03_all_postB1_EC11_changed_components8_proposals_actual_parent_scope_gate_failure_bottleneck_20261022.json\"\nRunStore.immutable_json(dest,out)\nprint(json.dumps({\"report\":str(dest.relative_to(root)),\"counts\":counts,\"EC_actual_new_scope_publications\":[{k:r[k] for k in (\"batch\",\"attempt\",\"coordinate\",\"changed_EC_jurisdictions_within_coordinate\")} for r in changed if r[\"classification\"]==\"accepted_actual_EC_component\"],\"all_gate_flags_recomputed\":True,\"no_new_model_calls\":True},ensure_ascii=False))\n"
}
