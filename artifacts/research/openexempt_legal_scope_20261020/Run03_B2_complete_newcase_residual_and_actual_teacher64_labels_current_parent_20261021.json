  "audit_recomputation_program": "import json,pathlib,collections\nimport experiments.openexempt_online as e\nfrom legal_skill_guard.openexempt import upstream\nfrom legal_skill_guard.learning.experiment import now\nfrom legal_skill_guard.utils.hashing import canonical_json_sha256 as csha\nroot=pathlib.Path.cwd();r=root/\"runs/legal_openexempt_closed_feedback_public_assets128_20261021_run03\";read=lambda p:json.loads(p.read_text())\nassert (r/\"batches/b2_prequential_records.json\").exists() and (r/\"batches/b2_prequential.json\").exists()\ncfg=read(root/\"configs/openexempt_closed_feedback_public_assets128_20261021_run03.json\")\npub=read(r/\"publications/b1.json\");parent=pub[\"bank\"];bank_hash=csha(parent)\nrecords=read(r/\"batches/b2_prequential_records.json\")\nd1=read(r/\"candidates/b1_candidate1.json\");d2=read(r/\"candidates/b1_candidate2.json\")\nparents={(x[\"case_id\"],x[\"family\"]):x for x in d2[\"actual_replay\"]+records[\"skills\"]}\nwirepath=r/\"teacher/b2_candidate1/wire_request.json\";w=read(wirepath);b=json.loads(w[\"user_prompt\"])\nassert b[\"current_parent_library\"]==parent and b[\"candidate_feedback_contract\"][\"attempt\"]==1\nassert b[\"candidate_feedback_contract\"][\"current_attempt_parent_bank_sha256\"]==bank_hash\nassert b[\"current_source_case_ids\"]==list(range(197,213))\nmanifest=b[\"training_evidence_manifest\"]\nassert manifest[\"selected_historical_source_ids\"]==list(range(181,197)) and not manifest[\"omitted_historical_source_ids\"]\nkeys={(i,f) for i in range(181,213) for f in (\"EC\",\"EV\")}\nassert {(x[\"source_case_id\"],x[\"family\"]) for x in b[\"already_seen_training\"]}==keys and len(b[\"already_seen_training\"])==64\nmembers={str(p.relative_to(root)) for p in [wirepath,r/\"publications/b1.json\",r/\"candidates/b1_candidate1.json\",r/\"candidates/b1_candidate2.json\",r/\"batches/b2_prequential.json\",r/\"batches/b2_prequential_records.json\"]}\nrows={(x[\"case_id\"],x[\"family\"]):x for x in read(root/cfg[\"input_packet\"])[\"rows\"] if (x[\"case_id\"],x[\"family\"]) in keys}\nfor x in b[\"already_seen_training\"]:\n key=x[\"source_case_id\"],x[\"family\"];v=x[\"actual_parent_answer\"];expected=parents[key];row=rows[key]\n gp=root/cfg[\"grading_directory\"]/f\"{key[0]}.json\"\n assert x[\"original_training_target\"]==read(gp)[\"targets\"][key[1]] and x[\"facts\"]==row[\"components\"][\"facts\"]\n assert v[\"executed_answer\"]==expected[\"parsed\"][\"answer\"] and v[\"score\"]==expected[\"score\"]\n messages,schema,supplied=e.actor_payload(row,parent,grounded=True,direct_numeric=True,asset_references=True)\n raw=read(root/expected[\"raw_call_path\"]);call=raw[\"calls\"][0];req=call[\"request\"]\n assert expected[\"bank_sha256\"]==bank_hash and req[\"messages\"]==messages and req[\"response_format\"][\"json_schema\"][\"schema\"]==schema\n assert expected[\"delivered_skill_ids\"]==[s[\"id\"] for s in supplied]\n trace=v[\"source_model_emitted_evidence\"];reasoning=call[\"response\"][\"choices\"][0][\"message\"].get(\"reasoning_content\") or \"\"\n assert trace[\"canonical_call_sha256\"]==csha(call) and trace[\"reasoning\"][\"text\"]==reasoning[-1024:] and trace[\"reasoning\"][\"canonical_text_sha256\"]==csha(reasoning)\n members.update((expected[\"raw_call_path\"],str(gp.relative_to(root))))\nfeedback_summaries=[]\nfor f in b[\"rejected_candidate_feedback\"]:\n attempt=f[\"candidate_feedback_origin\"][\"attempt\"];d={1:d1,2:d2}[attempt]\n proposals={(x[\"case_id\"],x[\"family\"]):x for x in d.get(\"proposed_replay\",d[\"actual_replay\"])}\n witnesses=f[\"feedback_witness_replay\"];references=f[\"feedback_reference_replay\"]\n assert f[\"candidate_feedback_origin\"][\"batch\"]==1 and 0<len(witnesses)<=8 and len(witnesses)==len(references)\n for x in witnesses:\n  expected=proposals[x[\"case_id\"],x[\"family\"]]\n  assert x[\"score\"]==expected[\"score\"] and x[\"executed_answer\"]==expected[\"parsed\"][\"answer\"]\n for x in references:\n  expected=parents[x[\"case_id\"],x[\"family\"]]\n  assert x[\"reference_is_this_request_parent\"] and x[\"bank_sha256\"]==bank_hash and x[\"record_sha256\"]==csha(expected) and x[\"score\"]==expected[\"score\"]\n feedback_summaries.append({\"origin\":f[\"candidate_feedback_origin\"],\"witness_count\":len(witnesses),\"references_are_current_B1_final_parent\":True})\nassert len(feedback_summaries)==2 and b[\"future_cases_and_labels_not_supplied\"] is True\nEvaluator=upstream(\"evaluator\").Evaluator;Claim=upstream(\"source.pydantic_response\").Claim;ev=Evaluator([])\nfailures={}\nfor arm in [\"empty\",\"skills\"]:\n rs=records[arm];byfamily={}\n for fam in (\"EC\",\"EV\"):\n  missing=collections.Counter();amount_errors=[];sums=collections.Counter()\n  for x in rs:\n   if x[\"family\"]!=fam:continue\n   score=x[\"score\"]\n   for z in (\"tp\",\"fp\",\"fn\"):sums[z]+=score[\"full_output_claim_\"+z]\n   target=read(root/cfg[\"grading_directory\"]/f'{x[\"case_id\"]}.json')[\"targets\"][fam]\n   answer=(x[\"parsed\"] or {}).get(\"answer\") or {};normalized={k.strip().lower():v for k,v in answer.items()};used=set()\n   for asset,claims in target.items():\n    match=ev._find_matching_asset_description(asset.strip().lower(),list(normalized))\n    ps=normalized[match] if match is not None and match not in used else []\n    if match is not None:used.add(match)\n    if fam==\"EC\":\n     present={Claim.normalize_citation(c) for c in ps}\n     for c in claims:\n      if Claim.normalize_citation(c) not in present:missing[c]+=1\n    else:\n     present=collections.defaultdict(list)\n     for c in ps:present[Claim(**c).normalized_citation].append(c[\"claim_value\"])\n     for c in claims:\n      citation=Claim(**c).normalized_citation;amounts=present[citation]\n      if not amounts:missing[c[\"citation\"]]+=1\n      elif not any(ev._absolute_relative_error(v,c[\"claim_value\"])<.05 for v in amounts):\n       amount_errors.append({\"case_id\":x[\"case_id\"],\"asset\":asset,\"citation\":c[\"citation\"],\"predicted_values\":amounts,\"target_value\":c[\"claim_value\"]})\n  byfamily[fam]={\"complete_claim_totals\":dict(sums),\"missing_citation_pairs\":sum(missing.values()),\"missing_by_citation\":dict(missing),\"matched_citation_amount_errors\":amount_errors}\n failures[arm]=byfamily\nempty={(x[\"case_id\"],x[\"family\"]):x for x in records[\"empty\"]}\npaired=[{\"case_id\":x[\"case_id\"],\"family\":x[\"family\"],\"empty_f1\":empty[x[\"case_id\"],x[\"family\"]][\"score\"][\"f1\"],\"skills_f1\":x[\"score\"][\"f1\"],\"difference\":x[\"score\"][\"f1\"]-empty[x[\"case_id\"],x[\"family\"]][\"score\"][\"f1\"],\"delivered_skill_ids\":x[\"delivered_skill_ids\"]} for x in records[\"skills\"]]\nout={\"at\":now(),\"classification\":\"Complete B2 new-case residual audit and actual teacher1 64 TRAIN task-label/current-parent/rejected-witness delivery; proposal result not yet required\",\n\"first_forecast_record_complete_before_audit\":True,\"current_source_cases\":16,\"historical_source_cases\":16,\"actual_teacher_labelled_tasks\":64,\n\"actual_teacher_parent_bank_sha256\":bank_hash,\"actual_teacher_parent_answer_and_reasoning_origins_verified\":64,\"manifest\":manifest,\n\"prior_partial_rejection_feedback\":feedback_summaries,\"residuals\":failures,\"same_source_paired_outcomes\":paired,\n\"teacher_response_exists_at_audit\":(r/\"teacher/b2_candidate1/response.json\").exists(),\"future_or_TEST_inputs_read\":False,\"new_model_teacher_or_TEST_calls\":0,\"evidence_paths\":sorted(members)}\nprint(json.dumps(out,ensure_ascii=False))\n"
}
