  "audit_recomputation_program": "import json,collections,hashlib\nfrom pathlib import Path\nfrom jsonschema import validate\nimport experiments.openexempt_online as e\nfrom legal_skill_guard.learning.publication import apply_differential_publication\nfrom legal_skill_guard.learning.task_scoped_skills import SCOPED_GUIDANCE_SCHEMA,validate_scoped_bank\nfrom legal_skill_guard.learning.legal_namespace import validate_scopes\nfrom legal_skill_guard.learning.experiment import now\nfrom legal_skill_guard.utils.hashing import canonical_json_sha256 as csha\nroot=Path.cwd();run=root/\"runs/legal_openexempt_closed_feedback_public_assets128_20261021_run03\"\nread=lambda p:json.loads(p.read_text());cfg=read(root/\"configs/openexempt_closed_feedback_public_assets128_20261021_run03.json\")\nwirepath=run/\"teacher/b1_candidate1/wire_request.json\";resppath=run/\"teacher/b1_candidate1/response.json\"\nw=read(wirepath);resp=read(resppath);body=json.loads(w[\"user_prompt\"])\nassert csha(w)==resp[\"request_sha256\"] and csha(resp[\"value\"])==resp[\"response_sha256\"]\nassert resp[\"cache_hit\"] is False and resp[\"invocation\"][\"returncode\"]==0 and not resp[\"invocation\"][\"tool_events_detected\"]\neventpath=run/\"teacher/b1_candidate1/event_log.json\";event=read(eventpath)\nassert csha({\"event_log\":event[\"event_log\"]})==resp[\"invocation\"][\"event_log_sha256\"]\nvalidate(resp[\"value\"],w[\"output_schema\"])\nall_ids=set(range(181,197));keys={(i,f) for i in all_ids for f in (\"EC\",\"EV\")}\nassert body[\"current_parent_library\"]==[] and body[\"current_source_case_ids\"]==sorted(all_ids)\nevidence=body[\"already_seen_training\"]\nassert len(evidence)==32 and {(x[\"source_case_id\"],x[\"family\"]) for x in evidence}==keys\nassert body[\"training_evidence_manifest\"][\"selected_historical_source_ids\"]==[]\nrecords=read(run/\"batches/b1_prequential_records.json\")\nparent={(r[\"case_id\"],r[\"family\"]):r for r in records[\"skills\"]}\nempty={(r[\"case_id\"],r[\"family\"]):r for r in records[\"empty\"]}\nfrozen={(r[\"case_id\"],r[\"family\"]):r for r in records[\"frozen_initial\"]}\nrows={(r[\"case_id\"],r[\"family\"]):r for r in read(root/cfg[\"input_packet\"])[\"rows\"] if r[\"case_id\"] in all_ids}\nmembers={str(p.relative_to(root)) for p in (wirepath,resppath,eventpath,run/\"batches/b1_prequential_records.json\")}\nfor x in evidence:\n key=x[\"source_case_id\"],x[\"family\"];row=rows[key];p=parent[key]\n targetpath=root/cfg[\"grading_directory\"]/f\"{key[0]}.json\"\n assert x[\"original_training_target\"]==read(targetpath)[\"targets\"][key[1]]\n assert x[\"facts\"]==row[\"components\"][\"facts\"] and x[\"public_solved_steps\"]==row[\"components\"][\"solved_steps\"]\n assert x[\"public_asset_reference_catalog\"]==e.public_asset_catalog(row)\n assert body[\"complete_public_statutes\"][x[\"public_statutes_ref\"]]==row[\"components\"][\"statutes\"]\n for field,source in ((\"actual_parent_answer\",p),(\"actual_same_case_empty_answer\",empty[key]),(\"actual_same_case_frozen_initial_answer\",frozen[key])):\n  view=x[field];assert view[\"executed_answer\"]==source[\"parsed\"][\"answer\"] and view[\"score\"]==source[\"score\"]\n  assert view[\"parse_error\"]==source[\"parse_error\"] and view[\"native_program\"] is None\n  assert \"full_output_f1\" in view[\"score\"] and \"negative_target_asset_predicted_claims\" in view[\"score\"]\n trace=x[\"actual_parent_answer\"][\"source_model_emitted_evidence\"]\n rawpath=root/p[\"raw_call_path\"];raw=read(rawpath);call=raw[\"calls\"][0]\n assert trace[\"canonical_call_sha256\"]==csha(call) and trace[\"raw_call_path\"]==p[\"raw_call_path\"]\n reasoning=call[\"response\"][\"choices\"][0][\"message\"].get(\"reasoning_content\") or \"\"\n assert trace[\"reasoning\"][\"text\"]==reasoning[-1024:] and trace[\"reasoning\"][\"canonical_text_sha256\"]==csha(reasoning)\n assert trace[\"reasoning\"][\"characters\"]==len(reasoning) and trace[\"finish_reason\"]==\"stop\"\n members.update((str(rawpath.relative_to(root)),str(targetpath.relative_to(root))))\nbank=apply_differential_publication([],resp[\"value\"],e.FAMILIES,sorted(all_ids),guidance_schema=SCOPED_GUIDANCE_SCHEMA)\nvalidate_scoped_bank(bank);validate_scopes(bank,next(iter(rows.values()))[\"components\"][\"statutes\"])\nassert all(not s[\"guidance\"][\"operators\"] for s in bank)\nchecked=[]\nfor path in sorted((run/\"native/b1_candidate1_replay\").glob(\"*.answer.json\")):\n r=read(path);row=rows[r[\"case_id\"],r[\"family\"]]\n messages,schema,supplied=e.actor_payload(row,bank,grounded=True,direct_numeric=True,asset_references=True)\n inp_path=path.with_name(path.name.replace(\".answer.json\",\".input.json\"));inp=read(inp_path);raw=read(root/r[\"raw_call_path\"]);req=raw[\"calls\"][0][\"request\"]\n assert r[\"bank_sha256\"]==csha(bank) and inp[\"messages\"]==req[\"messages\"]==messages\n assert inp[\"schema\"]==req[\"response_format\"][\"json_schema\"][\"schema\"]==schema\n assert r[\"delivered_skill_ids\"]==inp[\"delivered_skill_ids\"]==[s[\"id\"] for s in supplied]\n assert all(req[k]==cfg[\"generation\"][k] for k in (\"model\",\"max_tokens\",\"seed\",\"temperature\",\"top_p\",\"top_k\"))\n assert r[\"native_program\"] is None and r[\"execution_receipt\"] is None and r[\"execution_error\"] is None\n checked.append({\"case_id\":r[\"case_id\"],\"family\":r[\"family\"],\"delivered_skill_ids\":r[\"delivered_skill_ids\"],\"parse_error\":r[\"parse_error\"],\"finish_reason\":raw[\"response\"][\"finish_reason\"],\"raw_call_path\":r[\"raw_call_path\"]})\n members.update((str(path.relative_to(root)),str(inp_path.relative_to(root)),r[\"raw_call_path\"]))\nmanifest=read(root/\"configs/openexempt_closed_feedback_public_assets128_20261021_run03.frozen.json\")\nqueue=read(root/\"artifacts/launches/openexempt_main128_run03_to_ACE128_20261021_v2/queued.json\")\nsha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()\nfor group in (manifest[\"files\"],queue[\"source_data_environment_pins\"]):\n assert not [n for n,h in group.items() if sha(root/n)!=h]\nledger=read(root/cfg[\"teacher\"][\"ledger\"])\nassert ledger[\"max_invocations\"]==1797 and hashlib.sha256(json.dumps(ledger[\"reservations\"][:350],sort_keys=True).encode()).hexdigest()==\"b41ad3cccd7cb0d6465d64963cfa4971528a819242b66b6a837c132aedc4ae6e\"\nout={\"at\":now(),\"classification\":\"Actual Run03 B1 teacher1 full32 training-feedback and partially completed proposal delivery audit, not publication or generalization\",\n\"run_id\":run.name,\"selected_sources\":16,\"selected_training_tasks\":32,\"exact_original_targets_parent_answers_scores_and_raw_reasoning_tails_verified\":True,\n\"all_selected_EC_and_EV_scores_include_complete_output_and_negative_asset_fields\":True,\"teacher_fresh\":True,\"tool_events\":False,\n\"teacher_model\":resp[\"model\"],\"actual_invocation\":resp[\"invocation\"],\"parent_empty\":True,\n\"candidate_bank_sha256\":csha(bank),\"candidate_record_count\":len(bank),\"operations\":dict(collections.Counter(op[\"operation\"] for op in resp[\"value\"][\"operations\"])),\n\"skills\":[{\"id\":s[\"id\"],\"jurisdiction\":s[\"guidance\"][\"jurisdiction\"],\"tasks\":s[\"hypothesis_ids\"],\"operators\":s[\"guidance\"][\"operators\"]} for s in bank],\n\"actual_completed_candidate_wires_verified\":checked,\"completed_wires_are_partial_no_full_candidate_metrics_or_success_claim\":True,\n\"teacher_body_section_characters\":{k:len(json.dumps(v,ensure_ascii=False,separators=(\",\",\":\"))) for k,v in body.items()},\n\"all371_main_and381_waiter_bindings_current\":True,\"old350_ledger_prefix_unchanged\":True,\n\"ledger_reservations_snapshot\":len(ledger[\"reservations\"]),\"ledger_ceiling\":ledger[\"max_invocations\"],\n\"new_model_teacher_or_TEST_calls_by_audit\":0,\"evidence_paths\":sorted(members)}\nprint(json.dumps(out,ensure_ascii=False))\n"
}
