  "actual_changed_EC": [
    {
      "id": "EC:federal-wildcard-and-category-eligibility",
      "parent": {
        "when": "When FEDERAL is an allowable namespace and an estate asset is being classified.",
        "procedure": "Use two mandatory passes for each asset. First classify from the asset facts, never its value: § 522(d)(1) for an occupied residence, (d)(2) for a motor vehicle, (d)(3) for personally held household furnishings or goods, apparel, appliances, books, animals, crops, or musical instruments, (d)(4) for personally held jewelry, (d)(6) only for facts identifying an implement, professional book, or tool of trade, and (d)(9) for a professionally prescribed health aid. A ceiling limits protection but never defeats EC eligibility. Second add § 522(d)(5) to every asset without exception, including property already matching a specific paragraph. Before emitting, verify that each asset has (d)(5) and every factually matching specific paragraph.\nExecution example: Hypothetically, a personally held animal worth more than the (d)(3) ceiling still receives both (d)(3) and (d)(5). A personal appliance described as professional-grade receives (d)(3) and (d)(5), not (d)(6), unless the facts state trade use.",
        "avoid_when": "Do not place firearms or jewelry under § 522(d)(3), and do not infer § 522(d)(6) merely because an object could be used for work. Do not restrict § 522(d)(5) to personal property, omit it when another paragraph applies, or output §§ 522(b), 522(d), or 522(m) as asset exemptions.",
        "operators": [],
        "jurisdiction": "FEDERAL"
      },
      "proposed": {
        "when": "When FEDERAL is an allowable namespace and an estate asset is being classified.",
        "procedure": "Use two mandatory passes for each asset. First classify from the asset facts, never its value: § 522(d)(1) for an occupied residence, (d)(2) for a motor vehicle, (d)(3) for personally held household furnishings or goods, apparel, appliances, books, animals, crops, or musical instruments, (d)(4) for personally held jewelry, (d)(6) only for facts identifying an implement, professional book, or tool of trade, and (d)(9) for a professionally prescribed health aid. A ceiling limits protection but never defeats EC eligibility. Second add § 522(d)(5) to every asset without exception, including property already matching a specific paragraph. Before emitting, verify that each asset has (d)(5) and every factually matching specific paragraph.\nExecution example: Hypothetically, personal wearing apparel receives both (d)(3) and (d)(5) even when its value exceeds the (d)(3) ceiling; do not drop (d)(3). A personal appliance described as professional-grade receives (d)(3) and (d)(5), not (d)(6), unless the facts state trade use.",
        "avoid_when": "Do not place firearms or jewelry under § 522(d)(3), and do not infer § 522(d)(6) merely because an object could be used for work. Do not restrict § 522(d)(5) to personal property, omit it when another paragraph applies, or output §§ 522(b), 522(d), or 522(m) as asset exemptions.",
        "operators": [],
        "jurisdiction": "FEDERAL"
      }
    },
    {
      "id": "EC:oregon-general-personal-property",
      "parent": {
        "when": "When OREGON is allowable and the asset is personal property.",
        "procedure": "First include Or. Rev. Stat. § 18.345(1)(p) for every item of personal property, including a vehicle, firearm, or prescribed health aid. Then independently add every matching specific Oregon category exemption. The $400 ceiling does not determine EC eligibility.",
        "avoid_when": "Do not apply § 18.345(1)(p) to a homestead or other real property. Do not omit it because the asset exceeds $400 or because apparel, jewelry, household goods, animals, vehicles, musical instruments, firearms, or health aids have a more specific exemption.",
        "operators": [],
        "jurisdiction": "OREGON"
      },
      "proposed": {
        "when": "When OREGON is allowable and the asset is personal property.",
        "procedure": "First include Or. Rev. Stat. § 18.345(1)(p) for every item of personal property, including a vehicle, firearm, or prescribed health aid. Then independently add every matching specific Oregon category exemption. In particular, add § 18.345(1)(f) for household-use furniture, household goods, and domestic appliances or equipment; descriptive wording such as adjustable or professional-grade does not remove an otherwise household-use item from this category. The $400 ceiling does not determine EC eligibility.",
        "avoid_when": "Do not apply § 18.345(1)(p) to a homestead or other real property. Do not omit it because the asset exceeds $400 or because apparel, jewelry, household goods, animals, vehicles, musical instruments, firearms, or health aids have a more specific exemption.",
        "operators": [],
        "jurisdiction": "OREGON"
      }
    }
  ],
  "EV_projection_preserved": true,
