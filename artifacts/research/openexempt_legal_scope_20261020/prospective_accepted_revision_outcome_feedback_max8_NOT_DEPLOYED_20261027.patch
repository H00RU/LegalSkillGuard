+def accepted_commit_regressions(before_records, after_records, *, witness_limit=8):
+    """Bound real pre/post harms without changing aggregate admission or calling a model."""
+    if type(witness_limit) is not int or not 1 <= witness_limit <= 8:
+        raise ValueError("Commit regression evidence uses one to eight real witnesses")
+    before = {(r["case_id"], r["family"]): r for r in before_records}
+    after = {(r["case_id"], r["family"]): r for r in after_records}
+    if len(before) != len(before_records) or len(after) != len(after_records) or set(before) != set(after):
+        raise ValueError("Commit feedback requires the complete matching seen-source grid")
+    ranked = []
+    for key, record in after.items():
+        old, new = before[key]["score"], record["score"]
+        delta = min(new["f1"] - old["f1"],
+                    new.get("full_output_f1", new["f1"]) - old.get("full_output_f1", old["f1"]))
+        count_harm = any(new.get(k, 0) > old.get(k, 0) for k in
+                         ("invalid_format", "officially_unscored_predicted_claims",
+                          "negative_target_asset_predicted_claims"))
+        if delta < -1e-12 or count_harm:
+            ranked.append((delta, min(new["f1"], new.get("full_output_f1", 1)), *key))
+    if not ranked:
+        return None
+    chosen = [(v[2], v[3]) for v in sorted(ranked)[:witness_limit]]
+    return {"regressed_tasks_total": len(ranked), "witness_limit": witness_limit,
+            "before": [copy.deepcopy(before[k]) for k in chosen],
+            "after": [copy.deepcopy(after[k]) for k in chosen]}
