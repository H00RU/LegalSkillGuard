  "EC_projection_preserved": true,
  "actual_parent_Federal_EV": {
    "when": "When FEDERAL is allowable and an estate asset is being valued.",
    "procedure": "For each asset, first select every matching specific paragraph: (d)(1) for an occupied residence, (d)(2) for a motor vehicle, (d)(3) only for its listed household-use categories, (d)(4) for jewelry, (d)(6) only when the facts establish a trade implement, professional book, or tool, and (d)(9) for a professionally prescribed health aid. Separately add (d)(5) to every asset, even one already receiving a specific exemption. For each citation use the smaller of the whole named asset's value and its ceiling: $27,900 for (d)(1), $4,450 for (d)(2), $700 for the named particular item under (d)(3), $1,875 for (d)(4), and $2,800 for (d)(6); (d)(9) has no stated ceiling. For (d)(5), use $15,425 for one debtor or $30,850 for two equal joint debtors when no used homestead amount is supplied. Because this task evaluates asset-exemption pairs independently, do not reduce that amount merely because the same case also contains a residence claim.",
    "avoid_when": "Do not put firearms or jewelry under (d)(3), and do not infer (d)(6) without stated trade use. Treat a pair or set presented as one named asset as one particular item for the $700 (d)(3) output. Never copy a ceiling above the asset's value, leave a half-interest as the result, or use the one-debtor (d)(5) ceiling for two equal joint debtors. Do not output §§ 522(b), 522(d), or 522(m) as asset exemptions.",
    "operators": [],
    "jurisdiction": "FEDERAL"
  },
  "actual_proposed_Federal_EV": {
    "when": "When FEDERAL is allowable and an estate asset is being valued.",
    "procedure": "For each asset, first select every matching specific paragraph: (d)(1) for an occupied residence, (d)(2) for a motor vehicle, (d)(3) only for its listed household-use categories, (d)(4) for personal-use jewelry including a wristwatch, (d)(6) only when the facts establish a trade implement, professional book, or tool, and (d)(9) for a professionally prescribed health aid. Separately add (d)(5) to every asset, even one already receiving a specific exemption. For each citation use the smaller of the whole named asset's value and its ceiling: $27,900 for (d)(1), $4,450 for (d)(2), $700 for the named particular item under (d)(3), $1,875 for one debtor or a $3,750 combined whole-asset ceiling for two equal joint debtors under (d)(4), and $2,800 for (d)(6); (d)(9) has no stated ceiling. For (d)(5), use $15,425 for one debtor or $30,850 for two equal joint debtors when no used homestead amount is supplied. Because this task evaluates asset-exemption pairs independently, do not reduce that amount merely because the same case also contains a residence claim.",
    "avoid_when": "Do not put firearms or jewelry under (d)(3), and do not infer (d)(6) without stated trade use. Before finalizing a jewelry asset, verify that (d)(4), not (d)(3), is present and that its debtor-count ceiling is limited by the asset's value. Treat a pair or set presented as one named asset as one particular item for the $700 (d)(3) output. Never copy a ceiling above the asset's value, leave a half-interest as the result, or use the one-debtor (d)(5) ceiling for two equal joint debtors. Do not output §§ 522(b), 522(d), or 522(m) as asset exemptions.",
    "operators": [],
    "jurisdiction": "FEDERAL"
  },
  "content_scope": "Independent asset-exemption pair valuation means do not automatically deduct wildcard capacity for a residence elsewhere in the same case; named pair/set is one particular item; wristwatch/jewelry eligibility and debtor-count ceiling made explicit. This is a semantic/procedural edit, not native-format JSON demonstration and not yet an effective-repair result.",
