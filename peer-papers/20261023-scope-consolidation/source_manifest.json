Time Agent Evolution for Long-Horizon Legal Reasoning\",\"kind\":\"html\"}]\nFUNCTIONS={\"openexempt\":[\"背景\",\"评价缺口\",\"法律动机\",\"方案\",\"生成机制\",\"诊断能力\",\"规模\",\"实验发现\",\"资源\"],\"ace\":[\"背景\",\"既有局限\",\"方案\",\"机制\",\"效果与成本\",\"监督条件\",\"外部评测\",\"归纳\"],\"skillcommit\":[\"背景\",\"兼容缺口\",\"方案\",\"局部有效性\",\"抽象\",\"候选检索\",\"行为判据\",\"保持\",\"主结果\",\"迁移\"],\"trace2skill\":[\"缺口\",\"方案\",\"适用方式\",\"主结果\",\"泛化\",\"例证\",\"机制与比较\"],\"expel\":[\"背景\",\"调参代价\",\"访问约束\",\"需求\",\"方案\",\"经验提取\",\"使用\",\"主结果\",\"迁移\"],\"awm\":[\"缺口\",\"类比\",\"方案\",\"学习时序\",\"实验设置\",\"效果与成本\",\"泛化\"],\"reasoningbank\":[\"背景\",\"经验缺口\",\"方案\",\"在线机制\",\"扩展模块\",\"对比经验\",\"协同\",\"主结果\",\"归纳\",\"资源\"],\"financial_audit\":[\"审计问题\",\"协议\",\"收益与风险\",\"条件及总体风险\",\"机制解释\",\"独立重复\",\"方法差异\",\"接口问题\",\"敏感性\",\"归纳\"],\"wikiskill\":[\"背景\",\"现状\",\"历史知识缺口\",\"方案\",\"分层机制\",\"主结果\",\"模型规模\",\"迁移\",\"消融\",\"归纳\"],\"tala\":[\"法律场景\",\"异质性\",\"角色依赖\",\"设定\",\"经验机制\",\"协作机制\",\"主结果\",\"消融\"]}\nEXPECTED={\"openexempt\":201,\"ace\":197,\"skillcommit\":189,\"trace2skill\":170,\"expel\":183,\"awm\":190,\"reasoningbank\":217,\"financial_audit\":259,\"wikiskill\":201,\"tala\":190}\n\nimport json, re\nfrom pathlib import Path\nfrom html.parser import HTMLParser\n\nclass Node:\n    def __init__(self,tag,attrs=()):\n        self.tag,self.attrs,self.children=tag,dict(attrs),[]\n    def text(self):\n        if self.tag in (\"script\",\"style\",\"annotation\") or self.has(\"ltx_note\"): return \"\"\n        if self.tag==\"math\" and self.attrs.get(\"alttext\"): return self.attrs[\"alttext\"]\n        value=\"\".join(c if isinstance(c,str) else c.text() for c in self.children)\n        return (\" \"+value+\" \") if self.tag in (\"div\",\"p\",\"section\",\"h1\",\"h2\",\"h3\",\"h4\",\"h5\",\"h6\",\"li\",\"table\",\"tr\",\"td\",\"figure\",\"figcaption\") else value\n    def has(self,c):\n        return c in self.attrs.get(\"class\",\"\").split()\n\nclass Tree(HTMLParser):\n    def __init__(self,s):\n        super().__init__(convert_charrefs=True)\n        self.root=Node(\"root\"); self.stack=[self.root]; self.feed(s)\n    def handle_starttag(self,tag,attrs):\n        node=Node(tag,attrs); self.stack[-1].children.append(node)\n        if tag not in (\"meta\",\"link\",\"br\",\"hr\",\"img\",\"input\",\"wbr\",\"source\",\"area\",\"embed\",\"param\",\"col\"):\n            self.stack.append(node)\n    def handle_startendtag(self,tag,attrs):\n        self.stack[-1].children.append(Node(tag,attrs))\n    def handle_endtag(self,tag):\n        for i in range(len(self.stack)-1,0,-1):\n            if self.stack[i].tag==tag:\n                self.stack=self.stack[:i]; break\n    def handle_data(self,data):\n        self.stack[-1].children.append(data)\ndef walk(n):\n    yield n\n    for c in n.children:\n        if isinstance(c,Node): yield from walk(c)\ndef norm(s): return re.sub(r\"\\s+\",\" \",s.replace(\"\\u00ad\",\"\").replace(\"\\u200b\",\"\")).strip()\ndef wc(s): return len(re.findall(r\"(?:[A-Z]\\.){2,}|[0-9]+(?:,[0-9]{3})*(?:\\.[0-9]+)?|[A-Za-z0-9]+(?:[.’'-][A-Za-z0-9]+)*\",re.sub(r\"https?://\\S+\",\"\",s)))\nitems=PEERS\nfolder=Path(\"peer-papers/20261023-scope-consolidation\")\nrecords=[]\nfor item in items:\n    kind=item[\"kind\"]; key=item[\"key\"]\n    candidates=[folder/(key+\"_\"+item[\"id\"]+\".retry1.\"+kind),folder/(key+\"_\"+item[\"id\"]+\".\"+kind)]\n    path=next(p for p in candidates if p.is_file() and p.stat().st_size>1000)\n    if kind==\"html\":\n        root=Tree(path.read_text()).root; nodes=list(walk(root))\n        abstract=next(n for n in nodes if n.has(\"ltx_abstract\"))\n        ab=norm(abstract.text()); ab=re.sub(r\"^Abstract[.\\s:]*\",\"\",ab)\n        title=norm(next(n for n in nodes if n.has(\"ltx_title_document\")).text())\n        assert re.sub(r\"\\W\",\"\",item[\"title\"]).lower() in re.sub(r\"\\W\",\"\",title).lower(),(key,title)\n        headings=[norm(n.text()) for n in nodes if n.tag in (\"h2\",\"h3\",\"h4\")\n                  and \"ltx_title\" in n.attrs.get(\"class\",\"\")]\n        full=norm(root.text()); assert len(full)>20000,(key,len(full))\n    else:\n        assert path.read_bytes()[:4]==b\"%PDF\"\n        arecord=folder/(key+\"_\"+item[\"id\"]+\".abstract.html\")\n        aroot=Tree(arecord.read_text()).root\n        abstract=next(n for n in walk(aroot) if n.has(\"abstract\"))\n        ab=re.sub(r\"^Abstract\\s*\",\"\",norm(abstract.text()))\n        full=(folder/(key+\"_\"+item[\"id\"]+\".flow.txt\")).read_text()\n        assert len(full)>40000\n        headings=[\"Publisher PDF: collection, extraction/recall, inference and transfer; setup, ablation, transfer and analysis\"]\n    protected=re.sub(r\"\\b(?:[A-Z]\\.){2,}\",lambda m:m.group().replace(\".\",\"<DOT>\"),ab)\n    sentences=[s.replace(\"<DOT>\",\".\") for s in re.split(r\"(?<=[.!?])\\s+(?=[A-Z(])\",protected) if wc(s)>0]\n    records.append({**item,\"actual_full_text_path\":str(path),\"full_text_extracted_characters\":len(full),\n        \"abstract\":ab,\"abstract_sentences\":[{\"index\":i+1,\"words\":wc(s),\"text\":s} for i,s in enumerate(sentences)],\n        \"abstract_words\":wc(ab),\"headings\":headings})\nRESULT=records\n"
